# Bayram Payme gateway — copy to .env.payme and fill in. Never commit .env.payme.
# Read ONLY by the Payme Merchant API process (`make payme`), which loads bayram.payme.settings.
# PaymeSettings — not bayram.config.Settings and not bayram.admin.settings.AdminSettings. The bot,
# the worker and the admin panel never read this file.
#
# WHICH FILE IS THIS? `.env.payme` unless BAYRAM_PAYME_ENV_FILE names another — `make payme
# ENV=prod` reads `.env.payme.prod`, and bayram-payme.service reads `/etc/bayram/payme.env`. It is a
# THIRD env-file variable rather than a tier name shared with BAYRAM_ENV_FILE, for the reason
# .env.admin.example already gives about the second: the whole point of a separate file is that
# this process reads something the bot does not, and one knob deriving both paths would be one
# edit away from pointing them at the same file — at which moment the process with an inbound
# internet socket is holding the Telegram token. Set it in the process environment; writing it
# in here has no effect. The boot-time credential scan follows the same selection, so a key in
# whichever file was loaded is the key that gets refused.
#
# THE BLAST RADIUS, WHICH IS WHY THIS FILE EXISTS AT ALL
#
# There is exactly ONE secret here: BAYRAM_PAYME_MERCHANT_KEY, the Payme cashbox key. It is an
# INBOUND VERIFICATION secret — the endpoint only ever compares it against itself, to decide
# whether an inbound call really came from Payme. Stealing it lets somebody mint credits in
# our own database. It does NOT let them message every customer as the bot, and it does NOT
# let them spend the vendor balance, because there is no field on PaymeSettings that could
# hold a Telegram token or a vendor key: BAYRAM_TELEGRAM_BOT_TOKEN, BAYRAM_ELEVENLABS_API_KEY,
# BAYRAM_LLM_API_KEY and BAYRAM_LLM_FALLBACK_API_KEY have no code path into this process. That is a
# third blast radius, distinct from the bot's four outbound credentials and from the panel's
# operator sessions, and it is the whole argument for a fourth process.
#
# In prod, any one of those four sitting in this process's environment — or written into this
# file — is a boot REFUSAL naming the variable; in dev and staging it is a WARNING, because a
# shared dev .env is normal.
#
# The same rule downstream: this process sends nothing to Telegram and calls no vendor. Telling
# a customer their payment landed is an ARQ job the worker performs, which is why the only
# thing BAYRAM_REDIS_URL is used for is enqueuing that job.
#
# NOTHING HERE IS LIVE UNTIL BAYRAM_PAYME_ENABLED=true. The shipped default is false, and the
# bot's own BAYRAM_CHECKOUT_PROVIDER ships `stub`, so a deployment that copies this file and
# changes nothing behaves exactly as it did before Payme existed.

# ---------------------------------------------------------------------------
# Runtime — the same three variables the other processes read, same meanings.
# ---------------------------------------------------------------------------
BAYRAM_ENVIRONMENT=dev                       # dev | staging | prod
BAYRAM_LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR
BAYRAM_IS_DEBUG=false                        # human-readable logs instead of JSON; never in prod

# DEBUG is a privacy decision here too, and a sharper one than on the panel: it is the level at
# which the ORM echoes bound parameters, and on this path those parameters are idempotency keys
# carrying a Telegram user id and rail-side transaction ids — the two values that join a person
# to a payment. Refused outright when BAYRAM_ENVIRONMENT=prod.

# ---------------------------------------------------------------------------
# Infrastructure — the SAME database and Redis the other three processes use.
# ---------------------------------------------------------------------------
# Connect as the APPLICATION role (hbd_app in docker-compose's two-role split), never the owner
# role. Migration 0023's tables inherit that role's default grants; confirm it on the host — it
# is a deployment check, not an assumption. The gateway asks for pool_size=3, max_overflow=2:
# with bot 30, worker 30 and admin 10 that is 75 of a stock max_connections of 100, so
# installing it needs no host change. (Not 95: engine.py's "3 x 30 = 90" is the hypothetical
# the admin's smaller pool exists to avoid. See docs/deployment/08-payme.md section 3.1.)
BAYRAM_DATABASE_URL=postgresql+asyncpg://hbd:hbd@localhost:5432/hbd

# Used for ONE thing: enqueuing "your payment went through" onto the worker's queue. A Redis
# outage therefore costs a customer a delayed message and never a refused payment — the enqueue
# is after the commit, its failure is logged and swallowed, and the worker's sweep re-enqueues.
BAYRAM_REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# The gateway process. OFF by default: an endpoint that accepts money because a
# dependency was installed is not a decision anybody made. This is also the kill
# switch — taking the rail down is one variable and a restart, not a release.
# ---------------------------------------------------------------------------
BAYRAM_PAYME_ENABLED=false

# Bind to loopback and put the TLS terminator in front of it. Binding 0.0.0.0 publishes a
# credit mint to the internet with one shared secret in front of it. uvicorn is told these on
# the command line (see deploy/systemd/bayram-payme.service); the values here are what an operator
# compares that line against.
BAYRAM_PAYME_HOST=127.0.0.1
BAYRAM_PAYME_PORT=8091

# Lets a fleet monitor read /readyz's detailed body (database, redis, sandbox flag) with no
# session and no cabinet key, through the X-Probe-Token header. Empty disables that path
# entirely; there is no default token to forget to change. Unauthenticated callers always get
# the constant {"status":"ok"} — "degraded" is the same fleet telemetry with fewer characters.
BAYRAM_PAYME_PROBE_TOKEN=

# ---------------------------------------------------------------------------
# The rail. Кассы -> the kassa -> Настройки -> Инструменты разработчика.
# ---------------------------------------------------------------------------
# The cashbox id. PUBLIC — it is rendered in the customer's browser address bar inside every
# checkout link — which is why it also belongs in the bot's .env, and why it is not a secret
# here. It is compared against the merchant id STORED ON THE INTENT at settlement, so a
# deployment repointed at another cashbox while an old link is still live in somebody's chat
# produces a -31055 refusal instead of a customer charged by an account nobody reconciles.
BAYRAM_PAYME_MERCHANT_ID=

# ** THE ONE SECRET ON THIS HOST. ** 0640 root:bayram, and it never leaves this file: it is not
# sent anywhere, not written to any table, and not logged. The boot line records its LENGTH and
# never its value — the documentation says 36 characters, but the sandbox TEST_KEY's length is
# unverified and a wrong length assertion would be a boot failure on go-live day, so it is
# logged rather than asserted.
#
# Required whenever BAYRAM_PAYME_ENABLED=true. Because it is only ever compared against itself, an
# invented 36-character value is a fully functional gateway: that is what lets this whole
# integration be built, tested and rehearsed before Payme has handed anything over.
#
# ROTATION: stop the service, replace the value, start it. ChangePassword is dispatched and
# deliberately REFUSED with -32400 — implementing it would mean the one internet-facing process
# in this system rewrites its own credential on request. See docs/deployment/08-payme.md.
BAYRAM_PAYME_MERCHANT_KEY=

# The login half of the Basic-auth pair, compared WHOLE with the key under compare_digest —
# never split on ':' with only the key compared, which is what a widely installed third-party
# package does and which accepts any username. Both official merchant templates hard-code
# "Paycom"; the current documentation hedges, so it is a setting. The -32504 log line records
# the login that was actually PRESENTED (and never the key), so the first sandbox call answers
# the question rather than a support ticket.
BAYRAM_PAYME_BASIC_LOGIN=Paycom

# The account subfield name declared in the cabinet's «Настройка Аккаунт» form. IT MUST MATCH
# WHAT IS CONFIGURED THERE. If it does not, every CheckPerformTransaction is a -31050 that
# looks like our bug — which is why the -31050 log line names both this value and the field
# names that actually arrived. Set the cabinet to order_id, or set this to whatever the cabinet
# says.
BAYRAM_PAYME_ACCOUNT_FIELD=order_id

# "This order already has another active transaction" is a genuine contradiction inside Payme's
# own materials: the sandbox scenario text demands -31008, PaycomUZ's own PHP template returns
# -31050, and three third-party packages pick -31054 or -31099. It ships as a value so a
# certification finding is an environment variable and a restart rather than a release. Must be
# negative — a positive "code" would be read as a success.
BAYRAM_PAYME_DUPLICATE_TRANSACTION_CODE=-31008

# The rail's own transaction window, in milliseconds, measured from Payme's params.time and not
# from our created_at. 43200000 is the documented twelve hours. It is a setting so certification
# can drive the expiry branch in seconds: on expiry the transaction is CANCELLED (state -1,
# reason 4) and THEN refused with -31008, in that order, and an untested branch on the money
# path is how "cancel first, refuse second" silently becomes "refuse only".
BAYRAM_PAYME_TRANSACTION_TIMEOUT_MS=43200000

# Which cashbox environment this endpoint believes it is terminating. A LABEL, not a branch:
# nothing in this process selects a URL from it, because the gateway builds no links. The flag
# that governs settlement is the one stored ON THE INTENT when its link was built, so an old
# sandbox link cannot be settled against a production cashbox after somebody flips a setting.
# It appears in the boot line and in the authenticated /readyz body so an operator can see what
# was configured.
BAYRAM_PAYME_IS_SANDBOX=true

# An explicit checkout host, overriding the built-in constants (https://checkout.paycom.uz and
# https://test.paycom.uz). Blank means "derive". Read here by the operator CLI and the
# certification harness, which build links from this model; the BOT builds the links customers
# actually tap, from its own copy of the same value in .env. Payme has moved this hostname
# before, and a rail that can only be repointed by a release is down for as long as a release
# takes.
BAYRAM_PAYME_CHECKOUT_BASE_URL=

# Where Payme sends the browser after a payment. Blank is the shipped default and costs
# nothing: settlement is driven by the inbound PerformTransaction, never by the customer coming
# back, so the return link is a convenience.
#
# A ';' in this value is a BOOT REFUSAL. That character separates parameters inside Payme's
# base64 payload and their parser truncates the value at it while reporting nothing — verified
# against the live sandbox echo — and percent-encoding is not decoded on the way back out, so
# there is nothing to escape it with. A truncated deep link would send the customer somewhere
# almost right and nothing here would observe it.
#
# The only value the bot can answer is https://t.me/<bot_username>?start=paid — see the same
# variable in .env.example, which is the copy the BOT reads when it builds a link. This copy is
# read by the CLI and the harness so they can build a link off one configuration; if the two
# disagree, the bot's is the one a customer sees.
BAYRAM_PAYME_RETURN_URL=

# ---------------------------------------------------------------------------
# Caller identification. Both of these stay at their defaults in every shipped
# deployment; the caller allowlist is the TLS TERMINATOR's job, not this app's.
# ---------------------------------------------------------------------------
# How many proxy hops sit between this process and the internet. Zero means X-Forwarded-For is
# not read at all and the socket peer is the answer — which is correct behind a terminator on
# the same host, and which is what makes the allowlist below inert.
BAYRAM_PAYME_TRUSTED_PROXY_HOPS=0

# Comma-separated caller allowlist, enforced ONLY when the hop count above is non-zero. Payme
# originates from 185.234.113.0/28 and that range belongs in the terminator's configuration:
# with zero hops this process sees the terminator's address on every request, so a filter here
# would match one address and either pass everything or refuse everything — a filter matching
# the wrong address is worse than no filter, because it looks like a control. Every request
# journals its peer IP regardless, so the real caller set is discoverable from our own logs.
BAYRAM_PAYME_ALLOWED_CIDRS=
