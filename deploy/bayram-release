# Beat 1 — the backup. First, because it is the only step here that cannot be undone by
# running something again.
do_backup() {
  local label="$1"
  BACKUP="$BACKUP_DIR/pre-$label-$STAMP.sql.gz"
  step "back up the database ($PGDATABASE_NAME -> $BACKUP)"
  mkdir -p "$BACKUP_DIR"
  sudo -u postgres pg_dump "$PGDATABASE_NAME" | gzip > "$BACKUP"
  ls -lh "$BACKUP"
  # A pg_dump that failed on permissions still leaves a valid, empty gzip. A backup you did not
  # check is a backup you do not have. Verbatim from deploy-d17.sh:59 and deploy-support.sh:93,
  # including the exit status: an empty dump means the postgres side is misconfigured, which is
  # a config error (1), and it fires before anything on this host has been changed.
  test -s "$BACKUP" || { echo "FATAL: backup is empty, refusing to migrate"; exit 1; }
}

# Alembic, and ONLY alembic, runs with the environment file sourced.
#
# The predecessor scripts do `set -a; . "$ENVFILE"; set +a` at top level (deploy-d17.sh:62,
# deploy-support.sh:96), which exports the bot token and four vendor credentials into every
# later beat — the pip install, the systemctl calls, the verification python — none of which
# has any use for them. Here it happens inside a subshell, so beats 4 to 7 never carry them.
# env.py is what needs them: it reads BAYRAM_DATABASE_URL and BAYRAM_DB_MIGRATION_URL through
# bayram.config, and on this host the migration DSN is the owner role while the application DSN
# is not (deploy/fix-table-ownership.sql).
alembic_run() {
  (
    set -a
    # shellcheck disable=SC1090
    . "$ENVFILE"
    set +a
    exec "$VENV/bin/python" -m alembic -c "$ALEMBIC" "$@"
  )
}

# `alembic current` prints the revision on stdout; its INFO logging goes to stderr
# (migrations/alembic.ini:39-47, handler_console writes to sys.stderr), so stdout is the
# revision and nothing else. An unstamped database prints nothing at all — reported as "none"
# rather than as an empty string that would compare equal to a typo.
alembic_current_revision() {
  local out
  # NOT wrapped in `|| true`, and stderr is NOT sent to /dev/null. If alembic cannot run at all
  # this must abort loudly rather than quietly report "none": the failure mode on this host is a
  # `ModuleNotFoundError: No module named 'bayram'` out of env.py (04-release.md §0.4 warning 1),
  # and a swallowed one would read as "the database is unstamped" and invite a rerun.
  out="$(alembic_run current)"
  # The parenthesised decorations go first, whole — alembic prints "0028 (head)" and can print
  # "0028 (effective head)", and stripping them token by token would leave the word "head)"
  # behind as if it were a revision.
  #
  # `awk`, not `grep -v`, because grep exits 1 on no match and pipefail would turn an unstamped
  # database — which prints nothing and is a legitimate state — into an abort.
  #
  # Several revisions are joined with a comma rather than reduced to the first. A database with
  # two heads is a real problem, and a comparison against migrations.head SHOULD fail on it
  # instead of quietly picking one.
  printf '%s\n' "$out" \
    | sed -e 's/([^)]*)//g' \
    | tr -s '[:space:]' '\n' \
    | awk '
        $0 == "" { next }
        { revs = revs (revs == "" ? "" : ",") $0 }
        END { print (revs == "" ? "none" : revs) }'
}

# Beat 0.5 — stage the revision files the bundle carries.
#
# A WHEEL CARRIES NO MIGRATIONS. If a revision file is not under $VERSIONS, `upgrade head`
# stops at the revision before it and exits 0 — which looks exactly like success and leaves the
# schema short of what the code about to be installed needs (deploy-d17.sh:46-49,
# deploy-support.sh:58-65). This is also the drift 04-release.md §0.4 warning 1 describes from
# the other side: the wheel does not carry migrations/, so migrations/ drifted on its own and
# nothing noticed. Shipping alembic.ini, env.py and script.py.mako in the bundle is the fix,
# and the previous copies are kept beside them so a rollback is not stranded.
stage_migrations() {
  local staging="$WORK/staging" f base
  step "stage migrations into $MIGRATIONS_DIR"
  install -d -m 0755 -o root -g root "$MIGRATIONS_DIR" "$VERSIONS"

  for base in alembic.ini env.py script.py.mako; do
    f="$staging/migrations/$base"
    if [ -f "$MIGRATIONS_DIR/$base" ] && ! cmp -s "$f" "$MIGRATIONS_DIR/$base"; then
      cp -p -- "$MIGRATIONS_DIR/$base" "$MIGRATIONS_DIR/$base.prev-$STAMP"
      say "  $base changed; previous copy kept as $base.prev-$STAMP"
    fi
    install -m 0644 -o root -g root "$f" "$MIGRATIONS_DIR/$base"
  done

  # nullglob so a bundle with no revision files (a code-only release) leaves the loop body
  # unrun instead of trying to install a file literally named '*.py'. Preflight has already
  # proved the set on disk equals migrations.revisions, so there is nothing to second-guess.
  local had_nullglob=1
  shopt -q nullglob || had_nullglob=0
  shopt -s nullglob
  for f in "$staging/migrations/versions/"*.py; do
    base="$(basename "$f")"
    install -m 0644 -o root -g root "$f" "$VERSIONS/$base"
    test -f "$VERSIONS/$base" || { echo "FATAL: $base did not land in $VERSIONS"; exit 1; }
  done
  [ "$had_nullglob" -eq 1 ] || shopt -u nullglob
  say "  $M_REVCOUNT revision file(s) staged"
}

# Beats 2 and 3 — the revision before, the upgrade, and the assertion the old scripts lacked.
do_migrate() {
  step "revision before"
  REV_BEFORE="$(alembic_current_revision)"
  say "current: $REV_BEFORE"
  state_set revision_before "$REV_BEFORE"

  step "migrate -> head (expect $REV_BEFORE -> $M_HEAD)"
  alembic_run upgrade head

  REV_AFTER="$(alembic_current_revision)"
  say "current: $REV_AFTER"
  if [ "$REV_AFTER" != "$M_HEAD" ]; then
    state_set phase "migrate-wrong-head" revision_after "$REV_AFTER"
    fail_mid "the database is at revision '$REV_AFTER' but this bundle expects '$M_HEAD'.
THE MIGRATION DID NOT LAND WHERE IT SAID IT WOULD and the wheel has NOT been installed, so the
code running now is still the old code. Usual cause: a revision file that never reached
$VERSIONS, so 'upgrade head' stopped early and still exited 0 — which is exactly the silent
success this assertion exists to catch. Check '$VENV/bin/python -m alembic -c $ALEMBIC heads'
and the contents of $VERSIONS before retrying.
Backup for this attempt: ${BACKUP:-none}"
  fi
  say "revision assertion OK: $REV_AFTER == manifest migrations.head"
  state_set revision_after "$REV_AFTER"
}

# Beat 4 — install, and `pip check` on the very next line. ONE INDIVISIBLE STEP.
#
# --no-deps states an assumption: this release adds no new runtime dependency. `pip check`
# immediately afterwards, in the same script, before any restart, is what turns that assumption
# into an assertion that fails the deploy instead of a hope that fails a customer (08-payme.md
# §11.5, and the pillow lesson). Keep the two together; never put a restart between them.
do_install() {
  local staging="$WORK/staging"
  # PER-RELEASE DIRECTORY, and this is not tidiness. `pyproject.toml` pins a STATIC
  # `version = "0.1.0"`, so EVERY release builds a wheel named identically —
  # `bayram_bot-0.1.0-py3-none-any.whl`. Keyed on the basename alone, each deploy would
  # overwrite the previous wheel in the store and `rollback` would reinstall the very wheel it
  # was trying to back out of, reporting success. Keyed on the manifest's release string, the
  # store holds one directory per release and rollback has something real to install.
  # The proper fix is a version derived from the git tag (hatch-vcs); until then, this.
  install -d -m 0755 -o root -g root "$WHEEL_STORE/$M_RELEASE"
  WHEEL="$WHEEL_STORE/$M_RELEASE/$M_WHEEL"
  step "install the wheel"
  # The wheel is kept in $WHEEL_STORE and never deleted, because that store IS the rollback:
  # `rollback` reinstalls the previous release's wheel from here, so pruning it would remove
  # the only artefact the rollback path needs. It is also why the wheel is installed from the
  # store and not from the staging directory — the staging directory is gone by the time
  # anybody wants it back.
  install -m 0644 -o root -g root "$staging/$M_WHEEL" "$WHEEL"
  say "kept: $WHEEL"
  "$VENV/bin/pip" install --force-reinstall --no-deps "$WHEEL"
  "$VENV/bin/pip" check
  state_set wheel "$WHEEL" phase "installed"
}

# Beat 5 — restart, in 04-release.md §6's order, as FOUR separate calls.
restart_unit() {
  local unit="$1"
  local before after
  step "restart $unit"
  # NRestarts BEFORE and AFTER, because `is-active` alone cannot see a crash loop. The live
  # units are written with `Restart=on-failure` and `RestartSec=5` (cutover-to-bayram.sh:148),
  # so a unit that dies on boot is restarted every five seconds and will read `active` or
  # `activating` to any single sample. A deploy that ships a wheel which cannot start would
  # print DEPLOYED. Comparing the restart counter across the settle window is what catches it.
  before="$(systemctl show -p NRestarts --value "$unit" 2>/dev/null || echo 0)"
  systemctl restart "$unit"
  sleep "$SETTLE"
  # BARE, AND IT STAYS BARE. `systemctl is-active` exits non-zero if the unit is not active, so
  # under set -e it is a real gate. Wrapping it in `if` or appending `|| true` turns the gate
  # into a comment. The ERR trap above is what maps its exit status onto the contract's codes;
  # it does not swallow the failure.
  systemctl is-active "$unit"
  after="$(systemctl show -p NRestarts --value "$unit" 2>/dev/null || echo 0)"
  if [ "${after:-0}" -gt "${before:-0}" ]; then
    say "FATAL: $unit restarted $((after - before)) time(s) during the settle window."
    say "It is crash-looping, not running. Read: journalctl -u $unit -n 50 --no-pager"
    return 1
  fi
}

restart_fleet() {
  local unit
  for unit in "${UNITS[@]}"; do
    restart_unit "$unit"
  done
}

start_unit() {
  local unit="$1"
  step "start $unit"
  systemctl start "$unit"
  sleep "$SETTLE"
  systemctl is-active "$unit"
}

stop_fleet() {
  step "stop the fleet"
  # Reverse of the start order, written out rather than computed: the customer-facing processes
  # go down first and the admin API last, so the operator keeps their window on the system for
  # as long as possible. Stopping the worker sends SIGTERM, which CANCELS running renders — arq
  # requeues them, and the customer sees a timed-out frame followed by a song that arrives on
  # the next attempt, at the cost of a second vendor render (04-release.md §6). Stop the fleet
  # when the queue is quiet if you have the choice.
  local unit
  for unit in bayram-payme bayram-worker bayram-bot bayram-admin; do
    say "stopping $unit"
    systemctl stop "$unit"
  done
}

# Beat 6 — verify. Importable modules, the alembic revision, and every unit active.
do_verify() {
  local expect_head="$1" expect_wheel="$2"

  step "verify — the code that is running is the code that was deployed"
  "$(pybin)" - "$expect_wheel" <<'PY' || fail_verify "the installed code did not import cleanly"
import importlib, sys, os

# The four modules the four units actually start (04-release.md §6 records the command lines).
# Importing them here is what turns "the wheel installed without error" into "the wheel
# installed something that loads".
# `bayram.worker` is NOT in this list, and its absence is deliberate. `src/bayram/worker.py`
# runs `_SETTINGS = _settings()` at MODULE SCOPE, so importing it calls `load_settings()` and
# fails without the environment — and this script scopes the env file to the alembic
# invocation alone, so beats 4-7 never carry the bot token. Importing it here would make every
# deploy exit 4 AFTER the wheel was installed and the fleet restarted, which is the worst place
# to fail. `systemctl is-active bayram-worker` is what proves the worker loads; it starts with
# the environment systemd gives it, which is the only environment that matters.
mods = ["bayram", "bayram.config", "bayram.main",
        "bayram.admin.app", "bayram.payme.app"]
failed = []
for name in mods:
    try:
        mod = importlib.import_module(name)
    except Exception as exc:                   # noqa: BLE001
        failed.append(f"{name}: {type(exc).__name__}: {exc}")
    else:
        print(f"  import {name:<20} {getattr(mod, '__file__', '(namespace)')}")

if failed:
    print("\nmodules that did not import:", file=sys.stderr)
    for line in failed:
        print(f"  - {line}", file=sys.stderr)
    sys.exit(1)

# The installed distribution version must equal the version in the wheel's filename. A wheel
# whose filename says one thing and whose metadata says another means pip installed something
# other than what this script handed it.
wheel = os.path.basename(sys.argv[1])
parts = wheel[:-4].split("-") if wheel.endswith(".whl") else []
if len(parts) >= 2:
    dist_name, dist_version = parts[0], parts[1]
    from importlib.metadata import version, PackageNotFoundError
    found = None
    for candidate in (dist_name, dist_name.replace("_", "-"), "bayram-bot", "bayram"):
        try:
            found = (candidate, version(candidate))
            break
        except PackageNotFoundError:
            continue
    if found is None:
        # A warning, not a failure: the distribution NAME is a packaging fact this script does
        # not get to assert, and the imports above already proved the code is present.
        print(f"  WARNING: no installed distribution found for '{dist_name}' — version not "
              f"asserted")
    else:
        name, got = found
        print(f"  installed {name} {got} (wheel filename says {dist_version})")
        if got != dist_version:
            sys.exit(f"installed {name} is {got}, but the wheel installed was {wheel}")
PY

  local rev
  rev="$(alembic_current_revision)"
  say "  alembic current: $rev"
  if [ -n "$expect_head" ] && [ "$rev" != "$expect_head" ]; then
    fail_verify "the database is at '$rev'; the deployed release expects '$expect_head'."
  fi
  say "  revision assertion OK"

  local unit
  for unit in "${UNITS[@]}"; do
    # Bare again, for the same reason. Under the `verify` subcommand the ERR trap maps a
    # failure here to exit 4.
    systemctl is-active "$unit"
    say "  $unit active"
  done
}

