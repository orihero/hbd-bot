cmd_plan() {
  STAGE_EXIT=2; STAGE_NAME="plan"
  PLAN_ONLY=yes
  require_host_layout
  ensure_dirs
  find_bundle
  stage_bundle
  preflight

  local cur_wheel cur_rev
  cur_wheel="$(state_get wheel)"
  cur_rev="$(alembic_current_revision)"

  cat <<PLAN

=========================== PLAN — NOTHING HAS BEEN CHANGED ===========================
bundle              $BUNDLE
release             $M_RELEASE
commit              $M_COMMIT
built at            $M_BUILT_AT
wheel               $M_WHEEL
console             carried in the wheel; digest checked against the manifest above

database            $PGDATABASE_NAME   (still named 'hbd'; the rename did not touch it)
revision now        $cur_rev
revision after      $M_HEAD
additive            $M_ADDITIVE
revision files      $M_REVCOUNT, to be staged into $VERSIONS

installed wheel now ${cur_wheel:-(state.json records none — this would be the first deploy
                    through bayram-release)}

WHAT deploy WOULD DO, in order:
  1  pg_dump $PGDATABASE_NAME | gzip  ->  $BACKUP_DIR/pre-$M_RELEASE-<stamp>.sql.gz, then
     'test -s' it, because a pg_dump that failed on permissions still leaves a valid EMPTY gzip
  2  stage $M_REVCOUNT revision file(s) plus alembic.ini, env.py and script.py.mako
  3  alembic current, then 'alembic upgrade head', then ASSERT the result is $M_HEAD
  4  pip install --force-reinstall --no-deps $M_WHEEL   &&   pip check
  5  restart, as four separate calls with an is-active after each:
       ${UNITS[0]} -> ${UNITS[1]} -> ${UNITS[2]} -> ${UNITS[3]}
  6  verify: import the four units' modules, assert the revision, assert each unit is active

PLAN
  if [ "$M_ADDITIVE" = "true" ]; then
    say "ORDER            migrate-first. Safe here because migrations.additive is true: for the"
    say "                 minute between beat 3 and beat 4 the OLD code runs against the NEW"
    say "                 schema, and old code ignores columns it has never heard of."
  else
    say "ORDER            MAINTENANCE WINDOW. migrations.additive is false, so the fleet is"
    say "                 STOPPED before beat 3 and started after beat 4. There is a real"
    say "                 outage; customers see the bot stop answering."
  fi
  cat <<'PLAN'

NOT DONE BY deploy, and still a person's job:
  * nothing is stopped, restored or rolled back automatically. Read the output.
  * the customer-visible side effects of a release are not reversible by rollback at all —
    04-release.md §8. A message already sent is sent.
=======================================================================================
PLAN
  say "plan complete. Nothing on this host was changed."
}

cmd_deploy() {
  STAGE_EXIT=2; STAGE_NAME="preflight"
  require_host_layout
  ensure_dirs
  find_bundle
  stage_bundle
  preflight

  # ---- everything above here changed nothing; everything below can ----
  local prev_wheel
  prev_wheel="$(state_get wheel)"

  STAGE_EXIT=3; STAGE_NAME="state"
  # Written BEFORE the risky beats. previous_wheel is captured from the state as it stood when
  # this deploy started, so a failure later on still leaves rollback one release back and not
  # two.
  state_set \
    phase "starting" \
    release "$M_RELEASE" \
    commit "$M_COMMIT" \
    built_at "$M_BUILT_AT" \
    bundle "$(basename "$BUNDLE")" \
    expected_head "$M_HEAD" \
    additive "$M_ADDITIVE" \
    maintenance_window "$MAINTENANCE_WINDOW" \
    previous_wheel "$prev_wheel" \
    started_at "$STAMP"
  say "state: $STATE"

  STAGE_NAME="backup"
  do_backup "$M_RELEASE"
  state_set backup "$BACKUP" phase "backed-up"

  STAGE_NAME="stage-migrations"
  stage_migrations

  if [ "$MAINTENANCE_WINDOW" = "yes" ]; then
    STAGE_NAME="stop"
    say ""
    say "MAINTENANCE WINDOW: the fleet goes down now and stays down until the wheel is in."
    stop_fleet
    state_set phase "fleet-stopped"
  fi

  STAGE_NAME="migrate"
  do_migrate

  STAGE_NAME="install"
  do_install

  STAGE_NAME="restart"
  if [ "$MAINTENANCE_WINDOW" = "yes" ]; then
    local unit
    for unit in "${UNITS[@]}"; do
      start_unit "$unit"
    done
  else
    restart_fleet
  fi
  state_set phase "restarted"

  STAGE_EXIT=4; STAGE_NAME="verify"
  do_verify "$M_HEAD" "$WHEEL_STORE/$M_RELEASE/$M_WHEEL"

  # STAGE_EXIT stays at 3 until the very last statement of this function. It was previously
  # cleared here, with the ERR trap still armed and three statements left to run — so a failure
  # in `state_set`, in the `mv`, or in the report below would have run `on_err` and exited 0:
  # a failed deploy reporting success, which is the single worst thing this script could do.
  state_set phase "deployed" deployed_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  # The consumed bundle is renamed out of the *.tar.gz glob rather than deleted: the next
  # `deploy` must not find two bundles, and an operator who needs to know what shipped should
  # still be able to open this one.
  local applied="$BUNDLE.applied-$STAMP"
  mv -- "$BUNDLE" "$applied"
  # Everything that can still fail has now succeeded. From here the function only prints.
  STAGE_EXIT=0

  cat <<DONE

=================================== DEPLOYED ==========================================
release        $M_RELEASE  (commit $M_COMMIT)
revision       $REV_BEFORE  ->  $REV_AFTER
wheel          $WHEEL_STORE/$M_RELEASE/$M_WHEEL
backup         $BACKUP
state          $STATE
bundle         consumed, kept as $applied

Rollback is the wheel, never the schema:
    sudo /opt/bayram/sbin/bayram-release rollback
=======================================================================================
DONE
}

cmd_verify() {
  STAGE_EXIT=4; STAGE_NAME="verify"
  require_host_layout
  local head wheel
  head="$(state_get expected_head)"
  wheel="$(state_get wheel)"
  if [ -z "$head" ] || [ -z "$wheel" ]; then
    die_usage "no deploy recorded in $STATE, so there is nothing to verify AGAINST. Run
'bayram-release deploy' first, or read the file yourself: the revision this host should be at
is not something this script is willing to guess."
  fi
  say "verifying release $(state_get release), expecting revision $head"
  do_verify "$head" "$wheel"
  say ""
  say "VERIFY OK — release $(state_get release), revision $head, all four units active."
}

cmd_backup() {
  STAGE_EXIT=1; STAGE_NAME="backup"
  require_host_layout
  ensure_dirs
  do_backup "manual"
  state_set last_manual_backup "$BACKUP"
  say ""
  say "Backup taken: $BACKUP"
  say "It is a plain SQL dump, gzipped, of database '$PGDATABASE_NAME'."
}

cmd_rollback() {
  STAGE_EXIT=1; STAGE_NAME="rollback-preflight"
  require_host_layout

  local prev cur backup release
  prev="$(state_get previous_wheel)"
  cur="$(state_get wheel)"
  release="$(state_get release)"
  backup="$(state_get backup)"

  if [ -z "$prev" ]; then
    die_usage "state.json records no previous_wheel, so this script has nothing to roll back TO.
Kept wheels are in $WHEEL_STORE, one directory per release — list them and reinstall by hand
if you know which you want (the directory name is the release; the wheel inside is named the
same for every release, because pyproject.toml pins a static version):
    ls -lt $WHEEL_STORE
    $VENV/bin/pip install --force-reinstall --no-deps $WHEEL_STORE/<release>/<wheel>
    $VENV/bin/pip check
then restart ${UNITS[0]}, ${UNITS[1]}, ${UNITS[2]}, ${UNITS[3]} one at a time."
  fi
  test -f "$prev" || die_usage "state.json names previous_wheel '$prev', which is not on disk.
Something removed it from $WHEEL_STORE. List what is left: ls -lt $WHEEL_STORE"

  cat <<ROLLBACK

================================ ROLLBACK — READ THIS =================================
currently deployed   ${cur:-unknown}   (release ${release:-unknown})
rolling back to      $prev

THE CODE ROLLS BACK. THE SCHEMA DOES NOT, AND THAT IS DELIBERATE.
A migration is not reversible in general: there is no rule that a revision has a downgrade at
all, and where one exists it is a DROP of what the upgrade created. Rolling the schema back
past a release that added a table would take the rows customers have written into that table
with it. On this host 'alembic downgrade' does not even run — 04-release.md §0.4 warning 1.

The additive shape that makes migrate-first safe is exactly what makes this safe in reverse:
the old code ignores the columns and tables the new revision added. They stay behind, unused,
costing nothing.

WHAT ROLLING BACK DOES NOT UNDO: anything already sent. A song delivered, a Telegram message,
a Payme settlement, an email. 04-release.md §8 calls these not reversible at all, and it
is right.
=======================================================================================
ROLLBACK

  if [ "$RESTORE_DB" = "yes" ]; then
    cat <<RESTORE

--restore-db WAS PASSED. THIS IS THE DESTRUCTIVE PATH.

It will restore this dump over the LIVE database '$PGDATABASE_NAME':
    ${backup:-(no backup recorded in state.json)}

EVERYTHING WRITTEN SINCE THAT DUMP WAS TAKEN IS LOST. Every order placed, every payment
recorded, every support ticket filed, every audit row appended, since:
    ${backup:-unknown}
There is no partial restore and no merge. The database is dropped to the dump's contents.

It also drops and recreates schema 'public' first, because the dump is a plain pg_dump without
--clean and will not load over existing tables. And it does NOT restore table ownership: this
host runs a two-role split (role '$PGDATABASE_NAME' owns, role '${PGDATABASE_NAME}_app' holds
DML), and a restore run as postgres can leave objects owned by the wrong role — the same
failure that stopped the cutover on 2026-09-11. deploy/fix-table-ownership.sql is what puts it
back, and you will probably have to run it afterwards.

RESTORE
    if [ -z "$backup" ]; then
      die_usage "--restore-db was passed but state.json records no backup path. Nothing to
restore. Dumps are in $BACKUP_DIR; pick one and restore it by hand, deliberately."
    fi
    test -f "$backup" || die_usage "the recorded backup '$backup' is not on disk."
    test -s "$backup" || die_usage "the recorded backup '$backup' is EMPTY. It is not a backup."

    if [ ! -t 0 ]; then
      refuse "--restore-db needs a terminal: it requires a typed confirmation, and this
invocation has no stdin to type into. Run it from an interactive shell."
    fi
    printf '\nType this phrase exactly to proceed, or anything else to abort:\n  %s\n> ' \
      "$RESTORE_PHRASE"
    local typed=""
    IFS= read -r typed || true
    if [ "$typed" != "$RESTORE_PHRASE" ]; then
      refuse "the phrase did not match. The database was not touched."
    fi
    say "phrase accepted."
  fi

  STAGE_EXIT=3; STAGE_NAME="rollback"
  state_set phase "rolling-back" rolled_back_from "${cur:-unknown}"

  if [ "$RESTORE_DB" = "yes" ]; then
    # The fleet goes down for a database restore, and only for a database restore. A code-only
    # rollback does NOT stop anything: reinstall-and-restart is beats 4 to 6 run with the older
    # wheel, and stopping first would turn a one-minute rollback into a real outage for no gain.
    stop_fleet
  fi

  step "reinstall the previous wheel"
  "$VENV/bin/pip" install --force-reinstall --no-deps "$prev"
  "$VENV/bin/pip" check

  if [ "$RESTORE_DB" = "yes" ]; then
    step "restore $backup over database $PGDATABASE_NAME"
    sudo -u postgres psql -v ON_ERROR_STOP=1 -d "$PGDATABASE_NAME" \
      -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;'
    gunzip -c -- "$backup" | sudo -u postgres psql -v ON_ERROR_STOP=1 -d "$PGDATABASE_NAME"
    say "restored. Table ownership is very likely wrong now — see deploy/fix-table-ownership.sql."
    local unit
    for unit in "${UNITS[@]}"; do
      start_unit "$unit"
    done
  else
    restart_fleet
  fi

  # previous_wheel is cleared rather than set to the wheel just rolled off. A second `rollback`
  # would otherwise put the broken release straight back on — a ping-pong that reads as a
  # working rollback twice and leaves the host on the bad code.
  state_set \
    wheel "$prev" \
    previous_wheel "" \
    phase "rolled-back" \
    rolled_back_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  STAGE_EXIT=0
  say ""
  say "ROLLED BACK to $prev."
  say "A further rollback is not automatic: kept wheels are in $WHEEL_STORE."
  if [ "$RESTORE_DB" = "yes" ]; then
    say "The database was RESTORED from $backup. Everything written after that dump is gone."
    say "Table ownership almost certainly needs deploy/fix-table-ownership.sql."
  else
    say "The schema was NOT rolled back. The tables and columns the migration added are still"
    say "there, unused by the older code, costing nothing."
  fi
  say "Run 'sudo /opt/bayram/sbin/bayram-release verify' once you know which revision to expect."
}

# ============================================================================================
# Argument handling. One subcommand, and at most the two documented flags.
# ============================================================================================
MAINTENANCE_WINDOW=no
# Set by `plan`, which must be able to describe ANY bundle, including one preflight would
# refuse to deploy. A dry run that refuses to run is not a dry run.
PLAN_ONLY=no
RESTORE_DB=no
BACKUP=""
REV_BEFORE=""
REV_AFTER=""
WHEEL=""
M_RELEASE=""; M_COMMIT=""; M_BUILT_AT=""; M_WHEEL=""; M_HEAD=""; M_ADDITIVE=""; M_REVCOUNT=""

main() {
  local cmd="${1:-}"
  [ $# -gt 0 ] && shift || true

  case "$cmd" in
    ""|-h|--help|help) usage; exit 0 ;;
    deploy|verify|rollback|backup|plan) ;;
    # The subcommand is checked BEFORE the root check so a typo gets the message it needs
    # rather than "must run as root", which sends the operator off to fetch sudo for a command
    # that was never going to run.
    *) usage >&2; die_usage "unknown subcommand: $cmd" ;;
  esac

  while [ $# -gt 0 ]; do
    case "$1" in
      --maintenance-window) MAINTENANCE_WINDOW=yes ;;
      --restore-db)         RESTORE_DB=yes ;;
      *) usage >&2; die_usage "unknown argument: $1
This script takes NO path argument, for any subcommand. Drop the bundle in $INCOMING
instead — a root script that accepts a caller's path is the hole the fixed sudoers grant
exists to close." ;;
    esac
    shift
  done

  # Each flag belongs to exactly one subcommand. Accepting --restore-db on `deploy` because it
  # happens to be ignored there would teach an operator a habit that does something else the
  # day they type it on `rollback`.
  if [ "$RESTORE_DB" = yes ] && [ "$cmd" != rollback ]; then
    die_usage "--restore-db is a rollback flag; '$cmd' does not take it."
  fi
  if [ "$MAINTENANCE_WINDOW" = yes ] && [ "$cmd" != deploy ] && [ "$cmd" != plan ]; then
    die_usage "--maintenance-window is a deploy/plan flag; '$cmd' does not take it."
  fi

  require_root "$cmd"

  case "$cmd" in
    deploy)   cmd_deploy ;;
    plan)     cmd_plan ;;
    verify)   cmd_verify ;;
    rollback) cmd_rollback ;;
    backup)   cmd_backup ;;
  esac
}

main "$@"
