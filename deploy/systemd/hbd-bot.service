# The Telegram bot. Long polling, so it needs outbound HTTPS and nothing inbound.
#
#   sudo cp deploy/systemd/*.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now hbd-bot
#
# SECRETS COME FROM HBD_ENV_FILE, NOT FROM EnvironmentFile=. That is deliberate, and it is
# the one thing in this file worth reading twice. `EnvironmentFile=` loads every value into
# the process environment, where it shows up in `systemctl show hbd-bot` and in
# /proc/<pid>/environ — readable by root and by anything that later runs as this user. The
# variable below names a 0640 root:hbd file that pydantic-settings reads directly, so the
# bot token and the two vendor keys never enter the process environment at all.
#
# Pointing at an absolute path outside /srv/hbd also means a `.env` left behind in the
# checkout by a hurried deploy cannot be read by accident: HBD_ENV_FILE wins over it.

[Unit]
Description=HBD Bot — Telegram long polling
Documentation=file:///srv/hbd/deploy/README.md
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=hbd
Group=hbd
WorkingDirectory=/srv/hbd
Environment=HBD_ENV_FILE=/etc/hbd/bot.env
ExecStart=/srv/hbd/.venv/bin/python -m hbd.main
Restart=always
RestartSec=5s

# Journal only. The app logs JSON when HBD_IS_DEBUG is false, which is what prod wants.
StandardOutput=journal
StandardError=journal

# --- hardening ---------------------------------------------------------------
# ReadWritePaths is /srv/hbd/var because that is AppContainer.data_root — the workspace and
# the local object store. Everything else under ProtectSystem=strict is read-only.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/srv/hbd/var

[Install]
WantedBy=multi-user.target
