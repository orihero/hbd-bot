# The admin panel. Paste into /etc/caddy/Caddyfile on the host, or import it.
#
# UNVERIFIED LIKE EVERYTHING ELSE IN deploy/. This file was written without access to the
# host. It assumes Caddy terminates TLS there because deploy/caddy/pay.bayrambot.uz.caddy
# assumes it — which is an assumption citing an assumption, not evidence. Row 12 of
# docs/deployment/00-host-inventory.md ("what terminates TLS in front of the admin API") is
# still empty. If aizu runs nginx, this file is the wrong shape entirely; translate the four
# decisions below rather than installing Caddy alongside whatever is already listening.
#
# WHY THE WHOLE HOSTNAME PROXIES, unlike pay.bayrambot.uz which exposes exactly one path.
# The admin API serves its own React bundle: `/` and every browser route render the SPA
# shell (src/hbd/admin/app.py:238-239), `/assets/*` is a static mount (app.py:298), and the
# JSON lives under `/api`. Splitting those across handlers buys nothing and breaks the SPA
# fallback the first time somebody deep-links to /users/1234.
#
# WHY 127.0.0.1:8080. The admin process binds loopback and that binding is a security
# control, not a default: the panel has no MFA, and "unreachable except through this proxy"
# is the compensating control the threat model names (src/hbd/admin/security/clientip.py:3-5,
# ADMIN_PANEL_PLAN §12.1 T13). The port is a HOST fact — uvicorn takes it on the command
# line and HBD_ADMIN_PORT is not read by anything that binds (settings.py:188-189, and
# docs/deployment/04-release.md §6 spells this trap out). 8080 here matches
# deploy/systemd/hbd-admin.service:30. Read the running process before you trust it.

admin.bayrambot.uz {
	# Optional, and worth considering: the panel is a username/password login with no
	# second factor. If the operators work from known addresses, this is the cheapest
	# control available. Left off because locking yourself out of the admin panel from
	# a hotel wifi is a real cost and only you know the address set.
	#
	# @operators remote_ip 203.0.113.0/24
	# handle not @operators {
	# 	respond 404
	# }

	reverse_proxy 127.0.0.1:8080 {
		# Caddy sets X-Forwarded-For and X-Forwarded-Proto itself. What the application
		# does with them depends on two variables in /etc/hbd/admin.env, and getting
		# them wrong is silent: every rate-limit bucket and every `last_ip` audit row
		# collapses onto the proxy's address.
		#
		#   grey cloud (DNS-only in Cloudflare, as pay.bayrambot.uz is):
		#     HBD_ADMIN_TRUSTED_PROXY_HOPS=1
		#     HBD_ADMIN_TRUSTED_PROXY_CIDRS=127.0.0.1/32
		#
		#   orange cloud (proxied through Cloudflare):
		#     HBD_ADMIN_TRUSTED_PROXY_HOPS=2
		#     HBD_ADMIN_TRUSTED_PROXY_CIDRS=127.0.0.1/32
		#
		# The CIDR is the PEER — always loopback, because Caddy is what connects to the
		# app. The hop count is how many appended entries to walk back past: Cloudflare
		# writes the client into XFF and Caddy appends Cloudflare's edge, so proxied
		# traffic is two entries deep (clientip.py:127-145).
		#
		# Unlike the Payme hostname, orange cloud is defensible here — this is a browser
		# talking to a login form, exactly the traffic Cloudflare's protections are built
		# for, and hiding the origin address is worth something. It is a choice, not a
		# default; make it deliberately and set the hop count to match.
	}

	# The application sets CSP, X-Content-Type-Options and Referrer-Policy on every
	# response (src/hbd/admin/middleware/security_headers.py:55-75). It does NOT set HSTS,
	# because the process does not know whether it is behind TLS — that is this file's job.
	#
	# Start at a low max-age and raise it once the certificate renews cleanly. Six months
	# with a mistake in it is six months of a hostname nobody can reach over http to fix.
	# No `includeSubDomains` and no `preload`: bayrambot.uz has sibling hostnames this file
	# knows nothing about, and preload is close to irreversible.
	header Strict-Transport-Security "max-age=86400"

	log {
		output file /var/log/caddy/admin.log {
			roll_size 10MiB
			roll_keep 30
		}
	}
}
