# Bayram — Tabriklar, Qoʻshiqlar. Copy to .env and fill in. Never commit .env.
# Every variable is BAYRAM_-prefixed and maps 1:1 to a field on bayram.config.Settings.
# Startup fails fast and names any variable that is missing or out of range.
#
# WHICH FILE IS THIS? The bot and the worker read `.env` unless BAYRAM_ENV_FILE names another
# — `make dev ENV=prod` reads `.env.prod`, and the systemd units read `/etc/bayram/bot.env`.
# BAYRAM_ENV_FILE is set in the PROCESS environment and is meaningless written in here: a
# dotenv file cannot name the dotenv file that is about to be read. The admin API reads
# `.env.admin` (see .env.admin.example) and never this file — it must not hold a vendor key.
# `host verified` logs `environment` and `env_file` at boot, so which one is live is never
# a guess. See README "Dev and prod: which file each process reads".

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
BAYRAM_ENVIRONMENT=dev                       # dev | staging | prod
BAYRAM_LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR
BAYRAM_IS_DEBUG=false

# Swap EVERY vendor for its fake: no key is read, no request is made, nothing is
# spent. All-or-nothing on purpose — a half-fake run spends money for a result
# nobody can trust. Refused outright when BAYRAM_ENVIRONMENT=prod.
BAYRAM_USE_FAKE_PROVIDERS=false

# ---------------------------------------------------------------------------
# Telegram  (REQUIRED)
# ---------------------------------------------------------------------------
# from @BotFather
BAYRAM_TELEGRAM_BOT_TOKEN=
# leave empty for long-polling in dev

# ---------------------------------------------------------------------------
# Infrastructure  (DATABASE_URL is REQUIRED)
# ---------------------------------------------------------------------------
BAYRAM_DATABASE_URL=postgresql+asyncpg://hbd_app:hbd_app@localhost:5432/hbd

# The OWNER role's DSN, read by migrations/env.py and by nothing else. Its presence is how
# a deployment declares the two-role split of README "Two Postgres roles": `hbd` owns the
# tables, `hbd_app` (above) is what every process connects as, and migration 0007's REVOKE
# on admin_audit_log only means something when the two are different roles. Leave it empty
# and everything still runs — migrations fall back to BAYRAM_DATABASE_URL with a WARNING and
# the panel reports the audit chain as "hmac-only", which is honest rather than silent.
#
# Deliberately NOT a field on Settings: the bot and the worker must never hold the owner
# credential, and a field on the shared object is an invitation to.
BAYRAM_DB_MIGRATION_URL=postgresql+asyncpg://hbd:hbd@localhost:5432/hbd
BAYRAM_REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# ElevenLabs — Eleven Music, RU/EN TTS (v3) and Scribe v2 STT  (KEY REQUIRED)
# ---------------------------------------------------------------------------
# sent as the xi-api-key header
BAYRAM_ELEVENLABS_API_KEY=
BAYRAM_ELEVENLABS_BASE_URL=https://api.elevenlabs.io
BAYRAM_MUSIC_MODEL_ID=music_v2               # music_v1 | music_v2 (v2 needed for inpainting)
BAYRAM_MUSIC_OUTPUT_FORMAT=mp3_44100_128
BAYRAM_MUSIC_MAX_CONCURRENCY=2               # 2 on Starter/Creator/Pro, 5 on Scale. A 429 above it.
# The ONE rate that ships non-zero: a placeholder list price, so the first render already
# carries a dollar figure — honestly labelled ESTIMATED and shown beside that label, never
# as a vendor-reported one. Reconcile it against the dashboard. Set it to 0 to say "I do not
# know this rate": the render is still measured and logged, cost_usd stays NULL and the
# Vendors panel prints "not priced". Zero is NOT a free render, and 0 is a legal value here.
BAYRAM_MUSIC_USD_PER_MINUTE=0.15             # the rate the usage line's cost estimate derives from
BAYRAM_TTS_MAX_CONCURRENCY=3
BAYRAM_TTS_MODEL_ID=eleven_v3
BAYRAM_STT_MODEL_ID=scribe_v2

# Leave at 0 to record billed characters without inventing a dollar figure.
BAYRAM_ELEVENLABS_USD_PER_CHARACTER=0

# ---------------------------------------------------------------------------
# Vendor rate card — what a call costs us, per unit
#
# A ZERO rate means NO RATE IS CONFIGURED, never "this call was free". The usage row is
# still written with its tokens, characters and latency; only the dollar figure is left
# NULL, and the Vendors panel prints "not priced" instead of $0.00. The two are different
# facts and a zero would collapse them into the wrong one.
#
# The card below ships EMPTY, and BAYRAM_MUSIC_USD_PER_MINUTE above does not. So a deployment
# nobody has priced still shows money on the Vendors screen — the music leg's, ESTIMATED
# from that placeholder — while speech, both LLM legs and transcription report nothing. The
# spend total there is therefore a true sum over a minority of the calls, which is what the
# costedCalls count and the provenance chip beside it exist to say out loud. Filling this
# card in is what makes the total cover the traffic.
#
# None of these is live-editable (docs/product/ADMIN_PANEL_PLAN.md §8.4): editing a rate while the
# system runs silently rewrites what every already-written row meant, against a cost_source
# that still claims the figure was derived from the rate card. Changing a rate is a deploy.
#
# OpenRouter reports its own usage.cost per call and that number always wins; these two
# pairs are the fallback arithmetic for a host that returns token counts and no price.
# ---------------------------------------------------------------------------
BAYRAM_LLM_USD_PER_MILLION_PROMPT_TOKENS=0
BAYRAM_LLM_USD_PER_MILLION_COMPLETION_TOKENS=0
# the FAILOVER account's own card — usually a different model on a different bill
BAYRAM_LLM_FALLBACK_USD_PER_MILLION_PROMPT_TOKENS=0
BAYRAM_LLM_FALLBACK_USD_PER_MILLION_COMPLETION_TOKENS=0
#
# There is deliberately NO BAYRAM_*_USD_PER_* setting for Scribe/STT. ElevenLabs bills it per
# minute of audio and nothing here measures audio duration — only the bytes uploaded — so a
# rate would have to be multiplied by a guessed bitrate. Transcription therefore carries no
# cost at all rather than a fabricated one.

# ---------------------------------------------------------------------------
# The TTS cast and routing — both are DATA, replaceable without a deploy.
# Leave empty for the shipped catalogue (3 characters x 4 languages) and the
# shipped routing (all four languages -> ElevenLabs, the only TTS vendor).
# A malformed override fails startup; it never silently restores the default.
# Adding a second vendor means supplying its voice ids here AND its route below;
# the id and the route travel together.
# ---------------------------------------------------------------------------
# a JSON array of voice entries
BAYRAM_TTS_VOICE_REGISTRY_JSON=
# e.g. ru=elevenlabs_tts
BAYRAM_TTS_ROUTES=

# ---------------------------------------------------------------------------
# LLM — intake normalisation, lyric writing, name respelling  (KEY REQUIRED)
# Gemini 3.7 Flash on the PAID tier. The free tier trains on your data and this
# payload contains a third party's name and private family facts.
# ---------------------------------------------------------------------------
# OpenRouter. It is OpenAI-compatible, so PROVIDER stays 'openai' and only the base URL
# changes. Swapping models is a one-line edit — no code change, no redeploy.
# sk-or-v1-...
BAYRAM_LLM_API_KEY=
BAYRAM_LLM_BASE_URL=https://openrouter.ai/api/v1
BAYRAM_LLM_MODEL_ID=google/gemma-4-31b-it:free
BAYRAM_LLM_PROVIDER=openai                   # gemini | openai — DECLARED, never inferred from the id
#
# Free models that support response_format (REQUIRED — the lyric call is strict JSON):
#   google/gemma-4-31b-it:free            Google lineage; best Uzbek prior of the free set
#   google/gemma-4-26b-a4b-it:free        smaller, faster
#   z-ai/glm-5.2:free                     256k ctx
#   minimax/minimax-m3:free               1M ctx
# Free models WITHOUT response_format (nemotron-3.5-lightning, inkling, laguna, ...) will
# fall through to the repair-and-revalidate path on every call. Avoid them.
#
# blank = no fallback
BAYRAM_LLM_FALLBACK_API_KEY=
BAYRAM_LLM_FALLBACK_PROVIDER=openai          # gemini | openai
BAYRAM_LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
BAYRAM_LLM_FALLBACK_MODEL_ID=z-ai/glm-5.2:free
#
# OPTIONAL, AND THE MOST DANGEROUS LINE IN THIS FILE. An OpenRouter *management* key — not an
# inference key — held for exactly one call: GET /api/v1/credits, the only endpoint that
# reports the account's prepaid pool. GET /api/v1/key, which the balance poller has always
# used, answers `limit: null` for an uncapped key, and a panel cannot draw "credits left" as
# a fraction without a denominator.
#
# A management key can CREATE AND REVOKE API KEYS and read the account: leaked, it does not
# merely bill you, it locks the workers out. So:
#   * leave it blank and everything still works — the poller reports the uncapped key, the
#     panel draws no ring, and no process refuses to start;
#   * it belongs to the PRIMARY account (BAYRAM_LLM_API_KEY's). The fallback account's row is
#     never read with it, because this variable cannot say which account it is for;
#   * the admin panel REFUSES TO BOOT in production holding it (VENDOR_SECRET_FIELDS), and
#     only the worker's hourly balance poll ever reads it.
BAYRAM_OPENROUTER_MANAGEMENT_KEY=
BAYRAM_LLM_TEMPERATURE=0.7
BAYRAM_LLM_MAX_OUTPUT_TOKENS=2048
#
# Turn a REASONING model's thinking trace off. Leave false for an ordinary model, and for
# any host that is not OpenRouter — the field is a gateway extension and a strict OpenAI
# endpoint rejects the whole request over it.
#
# Set it to true whenever the model id is a hybrid reasoning model, because the trace is
# billed and capped as OUTPUT: nemotron-3-super-120b spent 1,931 of the 2,048 tokens above
# on thinking, the lyric object arrived cut off mid-string, and every wizard lyric call
# died in the parser. Raising the cap is not the fix — at 8,192 the trace grew to 6,814 and
# the object was still unterminated. With this true the same model answered in 506 tokens.
BAYRAM_LLM_DISABLE_REASONING=false

# ---------------------------------------------------------------------------
# Object storage (S3-compatible; R2 preferred for zero egress)
# ---------------------------------------------------------------------------
# No S3 client ships in this build: bayram.storage.LocalFileStorage archives finished
# assets under ./var/archive. The settings above are read by the S3 backend that
# replaces it behind the same protocol.

# ---------------------------------------------------------------------------
# Vendor balance polling. Read ONLY by the ARQ worker: it polls OpenRouter and
# ElevenLabs for remaining credit and writes the vendor_balances table, and the
# admin panel READS that table. The panel never makes the call itself — it holds
# no vendor key and no HTTP client by design, which is why it runs as a third
# process. Nothing below is a credential: the poller authenticates with the keys
# already at the top of this file, and the one OpenRouter endpoint that would
# have needed a fifth ("Management key required") is deliberately not used.
#
# A balance that has never been polled reads as "not polled" on the tile, never
# as zero — a defaulted zero would say the account is empty and page an on-call
# engineer about a deployment nobody instrumented.
# ---------------------------------------------------------------------------
BAYRAM_VENDOR_BALANCE_POLL_ENABLED=true      # off = tiles render "not polled", the honest empty state
BAYRAM_VENDOR_BALANCE_TIMEOUT_S=10           # 0-60: one probe; matches the existing ElevenLabs health probe
BAYRAM_VENDOR_BALANCE_JOB_TIMEOUT_S=60       # 0-600: the whole cron. NOT the 900s sized for a music render
BAYRAM_VENDOR_BALANCE_ESTIMATE_WINDOW_DAYS=30  # 1-365: trailing window the per-song divisor is MEASURED over

# ---------------------------------------------------------------------------
# Timeouts, seconds
# ---------------------------------------------------------------------------
BAYRAM_LLM_TIMEOUT_S=45
BAYRAM_MUSIC_TIMEOUT_S=420
BAYRAM_TTS_TIMEOUT_S=60
BAYRAM_STT_TIMEOUT_S=30

# ---------------------------------------------------------------------------
# Retry bounds
# ---------------------------------------------------------------------------
BAYRAM_PROVIDER_MAX_ATTEMPTS=4
BAYRAM_PROVIDER_BACKOFF_BASE_S=5
BAYRAM_PROVIDER_BACKOFF_JITTER=0.2
BAYRAM_LLM_PARSE_MAX_ATTEMPTS=2              # re-prompts after a failed JSON repair

# ---------------------------------------------------------------------------
# THE NAME SUBSYSTEM — the product's differentiator
#
# BAYRAM_NAME_CANDIDATE_ORDER is the ranked list of candidate orthographies, tried
# left to right. IT IS CONFIGURATION, NOT CODE: a bake-off result is applied by
# reordering this line. Valid values:
#   stripped   — U+02BB modifier letters removed entirely   (Gulomjon)
#   canonical  — U+02BB preserved                           (Gʻulomjon)
#   hyphenated — syllable boundaries                        (Gu-lom-jon)
#   ascii      — U+0027 apostrophe                          (G'ulomjon)
#   phonetic   — respelling aimed at the vendor's grapheme model
#   cyrillic   — Cyrillic transliteration                   (Ғуломжон)
# Comma-separated, no duplicates.
# ---------------------------------------------------------------------------
BAYRAM_NAME_CANDIDATE_ORDER=stripped,canonical,hyphenated,ascii,phonetic
BAYRAM_NAME_VERIFICATION_MAX_ATTEMPTS=3      # re-rolls before we deliver the best attempt
BAYRAM_NAME_MATCH_MIN_SIMILARITY=0.85        # STT transcript vs intended name, post-normalisation
BAYRAM_NAME_CHUNK_DURATION_MS=8000           # the name gets its own chunk (3000-120000)
BAYRAM_IS_NAME_VERIFICATION_ENABLED=true

# ---------------------------------------------------------------------------
# Song and greeting shape
# ---------------------------------------------------------------------------
BAYRAM_SONG_LENGTH_MS=90000                  # 3000-600000. Eleven Music bills every
                                          # generated second, and the plan total equals
                                          # this value exactly, so this knob IS the bill.
BAYRAM_GREETING_MIN_DURATION_S=20
BAYRAM_GREETING_MAX_DURATION_S=45
# 0 sells a song-only kit and makes no TTS call at all.
BAYRAM_GREETINGS_PER_KIT=0

# ---------------------------------------------------------------------------
# Audio post — ffmpeg. Telegram sendVoice REQUIRES OGG/Opus or it renders as a
# file attachment instead of a waveform bubble.
# ---------------------------------------------------------------------------
BAYRAM_FFMPEG_BINARY=ffmpeg
BAYRAM_FFPROBE_BINARY=ffprobe
BAYRAM_FFMPEG_TIMEOUT_S=180                  # subprocess wall clock; not a vendor timeout
BAYRAM_LOUDNORM_SONG_LUFS=-14
BAYRAM_LOUDNORM_SPEECH_LUFS=-16
BAYRAM_LOUDNORM_TRUE_PEAK_DB=-1
BAYRAM_OPUS_BITRATE_BPS=32000
BAYRAM_OPUS_SAMPLE_RATE_HZ=48000
BAYRAM_FADE_IN_MS=250
BAYRAM_FADE_OUT_MS=1500
BAYRAM_SILENCE_TRIM_THRESHOLD_DB=-50

# ---------------------------------------------------------------------------
# Moderation and pricing
# ---------------------------------------------------------------------------
BAYRAM_IS_MODERATION_ENABLED=true
# THIS STAYS 0, AND THAT IS A DECISION RATHER THAN AN UNFINISHED ONE.
#
# It is what the RENDER GATE is quoted — PaymentProvider.authorize answers "may
# this order be rendered?" about a credit the customer ALREADY OWNS. The CHECKOUT
# below is what SELLS that credit. Two different questions, so two different
# numbers, and only one of them is a price anybody pays. Setting this non-zero at
# go-live would quote the customer a second time, at render, for something they
# have already bought.
#
# The only flag that moves when the Payme rail goes live is BAYRAM_CREDITS_ENFORCED.
# See DECISIONS.md D11 and PAYME_INTEGRATION §1.1 and §8.2.
BAYRAM_KIT_PRICE_AMOUNT_MINOR=0
BAYRAM_KIT_CURRENCY=UZS

# What the CHECKOUT quotes, as opposed to BAYRAM_KIT_PRICE_AMOUNT_MINOR above, which is
# what the RENDER gate is quoted at. Deliberately NOT the same number — the gate stays at
# 0 for the reason given above, and these two are allowed to diverge for good.
#
# MINOR UNITS (UZS tiyin, exponent 2). 1500000 == 15 000 UZS, 4900000 == 49 000 UZS.
# The rail is quoted in tiyin and so is PaymentAuthorization.amount_minor, so this is
# already the number a real integration sends; only the display divides by 100.
#
# 15 000 soʻm IS THE PRICE THE PRODUCT CHARGES TODAY — the owner's catalogue decision of
# 2026-09-14, shipped as the `single_song_price_minor` default in commit 604bb3f
# (src/bayram/config.py:503-507). This line said 700000 until 2026-09-15, four weeks after
# the repricing, because the commit moved the field default and missed the example beside
# it. That is worth stating rather than quietly correcting: a developer who copied this
# file got a paywall quoting less than half the real price, with nothing going red — the
# settings model has no opinion about what a price SHOULD be, only that it is an int ≥ 0.
# Whenever the field default moves, this line moves in the same commit.
BAYRAM_SINGLE_SONG_PRICE_MINOR=1500000       # one recording
BAYRAM_STARTER_PLAN_PRICE_MINOR=4900000      # the starter plan — PRICED BUT NOT OFFERED, see below
BAYRAM_STARTER_PLAN_SONGS=12                 # songs it mints, lazily, one per render
BAYRAM_STARTER_PLAN_DAYS=30                  # how long it keeps minting them

# The twelve-song plan was WITHDRAWN on 2026-09-14 and is not deleted, which is why the
# three lines above still carry real values. Its price, its shape, its fulfiller and its
# plan_purchases rows all stay: a customer who bought one before that date still has a
# running plan that must keep minting, and a receipt that must keep reading back against
# the amount they were charged. What is switched off is the BUTTON.
#
# Zeroing BAYRAM_STARTER_PLAN_PRICE_MINOR would have been the one-line version and is a
# trap — `ge=0` accepts it, and a plan priced at nothing is FREE to anyone still holding a
# checkout link minted before the change. The offer is withdrawn by the boolean instead.
BAYRAM_IS_STARTER_PLAN_OFFERED=false         # false sells single songs only

# ---------------------------------------------------------------------------
# Entitlements — the free allowance, recorded in credit_accounts / credit_ledger.
# It ships at 0 (see BAYRAM_FREE_ALLOWANCE_CREDITS below); the 3-per-30-days number is
# still the fallback wherever no settings object is in hand.
#
# The meter SHIPS DARK, and "dark" is exactly one thing: NOBODY IS REFUSED FOR
# HAVING RUN OUT. Everything else runs — the account is opened, the rolling
# allowance is minted, the blocked-account gate and the one-render-at-a-time cap
# both refuse, the debit is written and settled. An account with nothing left is
# covered by an `unenforced_render` grant and renders anyway; counting those rows
# is how you see what enforcement would have refused before you switch it on.
#
# It used to skip the ledger call entirely, which sounded safer and was not: the
# in-flight cap counts unsettled debit rows, so with no debits it refused nobody,
# and the worker's block check — inside the same skipped call — let an account
# blocked mid-render finish and ship. Both are abuse rails, and an abuse rail that
# ships switched off is not a rail.
#
# Flip it to true once songs are actually being sold: a refused customer now has a
# remedy — the pay and subscribe buttons on the checkout screen — which is what was
# missing when this flag first shipped dark. An operator can still comp a customer
# with `python -m bayram.tools.credits grant`.
# ---------------------------------------------------------------------------
BAYRAM_CREDITS_ENFORCED=false

# Free songs per rolling 30-day window, before anybody pays for anything.
#
# 0 IS THE PRODUCT. The free half of this bot is the LYRIC: the wizard writes it,
# shows it and lets the customer keep it, and the recording is what is sold. With a
# non-zero allowance here the pay and subscribe buttons do not appear at all until
# the allowance is spent, so the first customers meet a screen that says nothing
# about price and, three songs later, one that does.
#
# NOTE that the bot-side paywall does NOT read BAYRAM_CREDITS_ENFORCED — it appears
# whenever a purchase port and a price list are wired and the balance is short. A
# production deployment should still set BAYRAM_CREDITS_ENFORCED=true, so that the
# WORKER refuses a render the bot somehow let through instead of covering it with an
# `unenforced_render` grant. The two are separate switches on purpose: one decides
# what a customer is shown, the other decides what is actually spent.
BAYRAM_FREE_ALLOWANCE_CREDITS=0

# ---------------------------------------------------------------------------
# Settlement grace — how long a debit may sit unsettled before the in-flight cap
# stops counting it and the hourly sweep closes it (refunding it, or consuming it
# when the kit was already rendered).
#
# LEAVE THIS UNSET. Empty means "derive it from this deployment's own queue
# ladder": every `BAYRAM_QUEUE_JOB_TIMEOUT_S` an order may burn across
# `BAYRAM_QUEUE_MAX_TRIES` attempts, plus the `BAYRAM_PROVIDER_BACKOFF_BASE_S`
# deferrals in between — 4550s under the values above. A fixed number set here is
# a number that stops matching the queue the day someone tunes it, and a grace
# SHORTER than the ladder makes the sweep refund orders that are still rendering:
# the customer keeps the credit and gets the song.
# ---------------------------------------------------------------------------
#BAYRAM_SETTLEMENT_GRACE_S=

# ---------------------------------------------------------------------------
# Inbound gate — the throttle and the block cache that every message and button
# press passes through before any handler sees it.
#
# NEITHER IS BEHIND BAYRAM_CREDITS_ENFORCED. That flag exists so the balance check
# can ship dark without turning paying-intent customers away; these two refuse
# abuse, and an abuse rail that ships switched off is not a rail.
#
# The window is FIXED, not sliding, so a burst straddling a boundary can land up
# to twice BAYRAM_INBOUND_MAX_UPDATES inside one window of wall time. Fine for what
# it bounds: one account's tap rate, not a security boundary. A full walk through
# the wizard is about ten updates, so 30/minute is well clear of any real session
# — set it too tight and the bot tells a customer to slow down mid-order.
#
# The counters are PER PROCESS (in-memory). This repo deploys one polling bot, so
# that is the real limit today; run a second instance and each keeps its own
# ceiling. The same is true of the block cache, which is also the lag on an
# UNBLOCK: an operator lifting a block waits up to BAYRAM_INBOUND_BLOCK_CACHE_S per
# process. Lower it for a faster unblock, at one database read per account per
# window — taken inside the FSM lock, which is why it is cached at all.
#
# /privacy, /forget and /support are exempt from the block gate and from the
# update ceiling, always: blocking a person must never become the way their
# erasure request is refused. They carry a small budget of their own instead
# (BAYRAM_INBOUND_ERASURE_MAX_UPDATES) — /forget rewrites every ledger row for the
# account and deletes its balance, so exempt from EVERY limiter it was an
# unmetered write amplifier. A throttled repeat loses nothing: all three commands
# are idempotent, and the refusal says "send it again in a moment", never no.
# ---------------------------------------------------------------------------
BAYRAM_INBOUND_WINDOW_S=60
BAYRAM_INBOUND_MAX_UPDATES=30
BAYRAM_INBOUND_BLOCK_CACHE_S=60
BAYRAM_INBOUND_ERASURE_MAX_UPDATES=3

# ---------------------------------------------------------------------------
# Lyric budget — how many lyrics one account may have written for it per UTC day.
#
# This is the only ceiling on the FIRST vendor spend in the product. Writing a
# lyric is an LLM call, it happens on the customer's screen BEFORE the payment and
# credit gates, and those gates guard the worker — which someone who never presses
# Confirm never reaches. The per-draft cap (five writes) is reset by /start, so
# without this number a single person could drive unbounded spend one session at a
# time.
#
# NOT BEHIND BAYRAM_CREDITS_ENFORCED, deliberately: it refuses abuse, not customers.
#
# Twenty is derived, not picked. Three songs per 30-day allowance at the five
# writes one draft may spend is fifteen — so a customer ordering their whole
# month in one sitting AND rerolling every song to the per-draft limit still has
# headroom. Raise it if honest sessions are being refused; the number that matters
# for abuse is the order of magnitude.
#
# Unlike the inbound throttle above, this counter is a DATABASE ROW, not process
# memory: a budget a user can reset by making the bot restart is not a budget.
# ---------------------------------------------------------------------------
BAYRAM_LYRIC_WRITES_PER_DAY=20

# ---------------------------------------------------------------------------
# Support — where /support and the Report-a-problem button send a customer whose
# song came out wrong. An @handle, an email, a t.me link. Empty is honest and is
# the default: the bot then asks them to describe it in the chat rather than
# naming an inbox nobody reads.
# ---------------------------------------------------------------------------
BAYRAM_SUPPORT_CONTACT=

# ---------------------------------------------------------------------------
# Support tickets — THE STAFF GROUP IS NOT CONFIGURED HERE ANY MORE.
#
# BAYRAM_SUPPORT_GROUP_CHAT_ID and BAYRAM_SUPPORT_GROUP_THREAD_ID were removed on
# 2026-09-15. The group that receives ticket cards — and the optional forum topic
# inside it — is now CHOSEN IN THE ADMIN PANEL, on Support → Support group, and
# stored in the bot_chats table: SUPPORT_TICKETS_SPEC §3.8, DECISIONS.md D18's
# 2026-09-15 amendment. Moving the staff inbox used to mean editing a unit file,
# redeploying and restarting the bot; it is now a click by an admin or an owner
# (permission support.group.write) and takes effect on the next update.
#
# DO NOT ADD EITHER VARIABLE BACK, as a seed or as a fallback. The selected row is
# the only authority on purpose — two sources of truth here means the question
# "which room is this posting into?" has two answers during an incident, one of
# them invisible to the screen that claims to show it.
#
# How the panel learns about a group: Telegram has NO "list my groups" API, so the
# bot records each group it is ADDED to from now on (a my_chat_member update), and
# anything else — including the group the bot is already in today — is pasted into
# the panel as a raw chat id. A pasted id is an unverified claim, so selecting one
# queues a check that calls Telegram and posts a confirmation into the group; the
# panel shows verified, "checking…", or the named reason it failed.
#
# Nothing replaces these two variables. "No group selected" is what 0 used to mean
# and is still the shipped default: the ticket is written, the customer is
# answered, the board fills, only the group post is skipped.
# ---------------------------------------------------------------------------

# Base URL of the admin panel — e.g. https://panel.example.com — used for one
# thing only: the "Open in panel" button on the ticket card. Empty omits the
# button entirely rather than linking nowhere: Telegram validates a URL button at
# send time, so a half-filled value is not a dead button but a 400 that loses the
# whole card.
BAYRAM_SUPPORT_PANEL_BASE_URL=

# ---------------------------------------------------------------------------
# Retention, in days. The purge job reads these; the defaults are the ones the
# privacy commitments require, so shortening them is a policy decision.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Languages. Interface and output language are chosen INDEPENDENTLY.
# ---------------------------------------------------------------------------
BAYRAM_DEFAULT_UI_LANGUAGE=uz_latn           # uz_latn | uz_cyrl | ru | en
BAYRAM_SUPPORTED_LANGUAGES=uz_latn,uz_cyrl,ru,en

# ---------------------------------------------------------------------------
# Free tier — text and one short spoken clip, never music
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Queue
# ---------------------------------------------------------------------------
BAYRAM_WORKER_CONCURRENCY=15                 # keep below the provider ceiling
BAYRAM_QUEUE_JOB_TIMEOUT_S=900
BAYRAM_QUEUE_RESULT_TTL_S=3600            # how long a job result lingers in Redis
# Attempts one order gets before the queue gives up. The worker AND the job read this:
# on its last attempt the job stops asking for a retry, tells the customer why, and
# releases the wizard session — ARQ abandons an exhausted job without re-entering it.
BAYRAM_QUEUE_MAX_TRIES=5

# ---------------------------------------------------------------------------
# Outbound pacing — how fast this deployment may talk to Telegram.
#
# Every limiter above meters what comes IN. This one meters what goes OUT, and
# it exists because a broadcast is the first thing here that sends thousands of
# messages in a row. Telegram limits a bot at roughly 30 messages/second to
# different chats; going over earns a retry_after on the BOT TOKEN, which stops
# the orders too, not just the campaign.
#
# Twelve is under half of that ceiling. Reminders and broadcasts share one Redis
# bucket by name, on purpose — Telegram's limit is per token, not per feature, so
# two features each staying under it would not keep the token under it.
#
# The budget is a REDIS counter, not process memory, unlike the inbound throttle:
# it bounds a token shared by every replica, so two workers each keeping their own
# ceiling would send at exactly twice the number set here. When Redis is
# unreachable the pacer degrades to pacing each process on its own at this rate
# and logs it at ERROR — a weaker guarantee, never an unmetered one.
#
# Lower it if the logs show "telegram asked us to back off". Raising it above 30
# is refused at boot.
# ---------------------------------------------------------------------------
BAYRAM_BROADCAST_SEND_RATE_PER_S=12

# How long ONE send chunk may run before arq cancels it, and how long a claimed
# recipient may sit in "sending" before the sweep writes it off. They are a pair,
# and the lease must be the larger of the two.
#
# A chunk claims up to 200 recipients, marks each one "sending" in the database
# BEFORE the message leaves, and settles each outcome as it lands. A cancelled
# chunk therefore leaves rows nobody can classify — they may or may not have
# reached Telegram — and those are never retried, because sending a customer the
# same campaign twice is worse than an unresolved three in forty thousand. After
# the lease they become "unknown", which the panel shows as its own number.
#
# So do not shorten the chunk timeout to make chunks feel snappier: every
# cancellation buys an unresolved row.
BAYRAM_BROADCAST_CHUNK_TIMEOUT_S=120
BAYRAM_BROADCAST_SENDING_LEASE_S=300

# ---------------------------------------------------------------------------
# The CHECKOUT RAIL — which provider sells a credit, and the PUBLIC half of the
# Payme configuration. See DECISIONS.md D11, PAYME_INTEGRATION §1, and
# docs/deployment/08-payme.md for the host half.
#
# WHAT BELONGS IN THIS FILE AND WHAT DOES NOT — the merchant ID DOES, the
# merchant KEY DOES NOT. This file is read by the bot and the worker, and the BOT
# is what builds the checkout link, so it needs the merchant id — which is public
# by design: it is rendered inside a base64 blob in a URL a customer's browser
# opens. The Merchant API KEY is an INBOUND VERIFICATION secret held by exactly
# one process, the Payme gateway, and it lives only in the file that process
# reads. See .env.payme.example. In prod the bot REFUSES TO BOOT if
# BAYRAM_PAYME_MERCHANT_KEY is reachable in its environment or in this file, so this
# is enforced rather than merely requested.
#
# ONE HONEST LIMITATION, so nobody discovers it from a customer. The `l=`
# parameter in the link — the language Payme renders ITS OWN page in — is taken
# from BAYRAM_DEFAULT_UI_LANGUAGE and not from the individual customer's choice,
# because nothing on the charge path carries a per-customer language today. A
# Russian-speaking customer on a uz_latn deployment therefore sees Payme's page in
# Uzbek. Nothing about settlement depends on it; only the payment page reads it.
#
# Nothing here needs a value while the rail is off, which is the default.
# ---------------------------------------------------------------------------

# stub | payme, and ONLY those two — the field is a closed Literal, so a typo here is
# a boot failure naming BAYRAM_CHECKOUT_PROVIDER rather than a silent fall-through to the
# stub, which is the shape of "we went live and nothing sold".
#
# `stub` is today's behaviour: StubCheckoutProvider contacts nothing
# and reports every purchase paid, and it stays wired, constructed and tested
# whatever this says. Flipping to `payme` is the whole go-live, and it must move in
# the SAME EDIT as BAYRAM_CREDITS_ENFORCED=true — main.py refuses to boot on a live
# rail with a dark credit meter, because a real rail taking real money into a meter
# nobody reads is a free song sold for 7 000 UZS. Back to `stub` plus one restart
# is the complete rollback.
BAYRAM_CHECKOUT_PROVIDER=stub

# The cashbox id from Кассы -> the kassa -> Настройки -> Инструменты разработчика.
# Public. The gateway stores it on every intent and refuses a Perform whose intent
# was issued for a different cashbox (-31055), so a sandbox/production split-brain
# is a refusal rather than a customer charged by the wrong kassa.
BAYRAM_PAYME_MERCHANT_ID=

# Blank derives it: https://checkout.paycom.uz in production,
# https://test.paycom.uz when BAYRAM_PAYME_IS_SANDBOX=true. Set it explicitly only to
# point a dev machine at the sandbox parser, which echoes our parsed receipt back
# as JSON with no authentication at all.
BAYRAM_PAYME_CHECKOUT_BASE_URL=

# The account subfield name inside the link (`ac.<field>`). IT MUST EQUAL THE
# CABINET'S «Настройка Аккаунт» FIELD NAME EXACTLY, and that is configured by a
# human in a web form that no API can read. A mismatch makes every
# CheckPerformTransaction a -31050 that looks like our bug; the -31050 log line
# names the fields actually received alongside this one, so the diagnosis is one
# line of the journal.
BAYRAM_PAYME_ACCOUNT_FIELD=order_id

# Where Payme sends the customer after paying. Blank is the default AND IS SAFE:
# settlement is webhook-driven and depends on nothing the customer does. A `;`
# anywhere in this value is REFUSED at settings-build time — Payme's parser
# silently truncates at the first one, and a truncated deep link fails in a way
# nothing observes.
#
# THE ONE VALUE THIS BOT CAN ANSWER is `https://t.me/<bot_username>?start=paid`.
# `bayram.bot.handlers.start.handle_paid_return` is registered for exactly the payload
# `paid` (`PAID_DEEP_LINK`), redraws the balance from the meter and claims nothing.
# Any other payload falls through to the ordinary menu, so a wrong value here costs
# a returning customer their "your credit is here" screen and nothing else.
BAYRAM_PAYME_RETURN_URL=

# true stamps is_sandbox on every intent, so rehearsal rows are excludable from
# every revenue figure by construction. Keep it true until the production key is in
# place on the gateway.
BAYRAM_PAYME_IS_SANDBOX=true

# How long an issued checkout link stays payable, in seconds. Must be strictly less
# than the wizard-state TTL — a customer must never be able to pay for a draft that
# has already expired — and main.py asserts that at boot.
#
# Bounded 60..86400. Under a minute is not a product; longer than a day is a link
# whose second half is a promise the rail will not keep, because Payme's own
# transaction window is 12 hours and the default here matches it.
BAYRAM_PAYME_INTENT_TTL_S=43200

# Whether a settled REDIRECT payment starts the render it was opened for (DECISIONS
# D17). false restores the behaviour that shipped before it: the customer is told
# their payment landed and presses the Record button themselves.
#
# This is the ROLLBACK LEVER for that decision, which is why it is an environment
# variable and not a code change — it needs a restart, no deploy and no migration.
# Rolling back does NOT need migration 0026 reverted; dropping those columns while
# this is still true would take the at-most-once latch away with them.
#
# No effect on a stub deployment: the branch that records a render marker is only
# reachable when a rail answers "payment started", and the stub answers "paid".
BAYRAM_AUTO_RENDER_ON_PAYMENT=true

# How often the worker's sweep runs, in minutes. It is a BACKSTOP, not a mechanism:
# intent expiry is a predicate evaluated against the injected clock whenever a
# request forces the state machine to move, so nothing's correctness waits for this.
# The one arm that is genuinely about delivery is the re-enqueue of unsent "your
# payment went through" messages, which makes this number the ceiling on how long a
# paying customer can be left unnotified after a Redis outage. It is customer-facing,
# which is why it is a setting and not a constant. Bounded 1..60.
BAYRAM_PAYME_SWEEP_MINUTES=5
