# HBD admin panel — copy to .env.admin and fill in. Never commit .env.admin.
# Read ONLY by the admin API process (`make admin`), which loads hbd.admin.settings.
# AdminSettings — not hbd.config.Settings. The bot and the worker never read this file.
#
# WHY THIS FILE EXISTS AT ALL, AND WHY IT IS NOT .env
#
# There is deliberately NO vendor key and NO bot token here: not commented out, not
# empty, not optional — there is no field on AdminSettings that could hold one, so
# HBD_TELEGRAM_BOT_TOKEN, HBD_ELEVENLABS_API_KEY, HBD_LLM_API_KEY and
# HBD_LLM_FALLBACK_API_KEY have no code path into this process. That is the whole
# blast-radius argument for running the panel as a third process: an admin host that is
# compromised yields a database session and nothing else — no ability to message every
# customer as the bot, in perpetuity, and no ability to spend the vendor balance.
# Pointing the admin process at the shared .env would hand it all four by accident, which
# is why it reads its own file. In prod, any one of the four sitting in this process's
# environment is a boot REFUSAL naming the variable; in dev and staging it is a WARNING,
# because a shared dev .env is normal.
#
# The same rule downstream: the admin API sends nothing to Telegram and calls no vendor.
# Every action that needs one — a retry, a re-delivery, a file deletion — is enqueued as
# an ARQ job and performed by the worker, which is the process that holds the credentials
# and owns the writable volume.

# ---------------------------------------------------------------------------
# Runtime — the same three variables the bot reads, with the same meanings.
# ---------------------------------------------------------------------------
HBD_ENVIRONMENT=dev                       # dev | staging | prod
HBD_LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR
HBD_IS_DEBUG=false                        # human-readable logs instead of JSON; never in prod

# DEBUG is a privacy decision, not a verbosity one: it is the level at which the ORM
# would echo bound SQL parameters — recipient names, notes, lyrics — into logs that have
# no retention clock. configure_logging() floors sqlalchemy, aiogram, arq and uvicorn at
# WARNING so it cannot, and the panel refuses to set DEBUG when HBD_ENVIRONMENT=prod.

# ---------------------------------------------------------------------------
# Infrastructure — the SAME database and Redis the bot and worker use.
# The var/ volume is mounted READ-ONLY for this process (see below).
# ---------------------------------------------------------------------------
HBD_DATABASE_URL=postgresql+asyncpg://hbd:hbd@localhost:5432/hbd
HBD_REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# The panel itself. Off by default: an admin surface that appears because a
# dependency was installed is not a decision anybody made.
# ---------------------------------------------------------------------------
HBD_ADMIN_ENABLED=false

# The config editor's own switch, so the riskiest surface in the panel can be taken away
# without taking the panel away. Read only from this file — never from the override table,
# or a stolen session could turn the kill switch back on.
HBD_ADMIN_CONFIG_ENABLED=true

# Bind to loopback and put TLS in front of it. Binding 0.0.0.0 publishes a
# username/password login to the internet; nothing here is designed for that.
HBD_ADMIN_HOST=127.0.0.1
HBD_ADMIN_PORT=8080

# The origin the browser actually reaches, scheme included. Used for the CSP, for
# same-origin checks and for cookie scope, so a wrong value fails visibly rather than
# leaving a control half-applied. REQUIRED whenever HBD_ENVIRONMENT is not dev: the
# loopback value below is a dev convenience, and a staging or prod deploy that inherited
# it would boot, pass /healthz, serve a login page and then reject every state change
# with ORIGIN_REJECTED. Leaving it unset outside dev is a boot refusal instead.
HBD_ADMIN_PUBLIC_ORIGIN=http://127.0.0.1:8080

# ---------------------------------------------------------------------------
# Sessions. Two clocks, both enforced: an absolute cap the operator cannot slide
# past, and an idle window that expires an unattended browser sooner.
# ---------------------------------------------------------------------------
HBD_ADMIN_SESSION_TTL_S=43200             # 12h absolute lifetime, refresh or not
HBD_ADMIN_SESSION_IDLE_TTL_S=3600         # 1h since last request

# How long one step-up authorises further actions in the SAME scope, in seconds (0-900).
# 0 makes every action in a scope re-prompt. Purge and config commit/rollback ignore this
# entirely — they are unconditionally fresh — so raising it cannot loosen them.
HBD_ADMIN_STEP_UP_GRACE_SECONDS=300

# Session cookies are __Host-prefixed and SameSite=Lax, and Secure is sent in EVERY
# environment, dev included: the __Host- prefix is defined to make a browser reject a
# Set-Cookie that lacks Secure, so a dev panel without it stores no cookie and can never
# be signed into. http://127.0.0.1 is a secure context in Chrome and Firefox, so this
# costs dev nothing. Leave empty; setting it to false is refused at boot.
HBD_ADMIN_COOKIE_SECURE=

# ---------------------------------------------------------------------------
# argon2id. These are the cost of one login, paid on the admin host. Raise them
# until a verify takes ~250-500ms on YOUR hardware; the defaults assume a small
# VPS. Lowering them below the floors is refused, not warned about.
# ---------------------------------------------------------------------------
HBD_ADMIN_ARGON2_TIME_COST=3              # passes
HBD_ADMIN_ARGON2_MEMORY_KIB=65536         # 64 MiB per verify — the parameter that matters
HBD_ADMIN_ARGON2_PARALLELISM=4            # lanes; keep at or below the host's cores

# ---------------------------------------------------------------------------
# Client IP derivation. Every rate limit and every audit row records the client
# IP, so getting this wrong is not cosmetic: trusting X-Forwarded-For from an
# untrusted peer lets anyone forge the identity the throttle counts against.
#
# 0 hops means "use the peer address and ignore X-Forwarded-For entirely" — the
# right answer when nothing is in front of the process. Set it to the exact
# number of proxies you control, and list their addresses in the CIDR line; an
# XFF header from a peer outside that list is discarded, never merged.
# ---------------------------------------------------------------------------
HBD_ADMIN_TRUSTED_PROXY_HOPS=0
HBD_ADMIN_TRUSTED_PROXY_CIDRS=            # comma-separated, e.g. 10.0.0.0/8,192.168.1.5/32

# ---------------------------------------------------------------------------
# Audit log. The chain is HMAC-signed so a row cannot be edited in place without
# the break being detectable. This key is the only secret in this file: it is not
# a vendor credential, it protects the record of what operators did.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
HBD_ADMIN_AUDIT_HMAC_KEY=

# The audit table's OWNER role, which is NOT the role the app connects as. Its presence is
# what says the two-role setup of §4.5 is deployed: with it, migration 0007 revokes
# UPDATE/DELETE/TRUNCATE on admin_audit_log from the application role, so a compromised
# app credential cannot rewrite the record of what operators did. Leave it EMPTY and that
# REVOKE is skipped with a WARNING, and /audit/verify reports chainProtection "hmac-only"
# — a control that is not deployed is reported as not deployed, never implied.
HBD_ADMIN_AUDIT_DSN=

# ---------------------------------------------------------------------------
# Reveal budgets. A step-up authorises ONE action; these cap how much personal
# data one operator can pull in a shift, which is the difference between an
# investigation and an export nobody asked for. Both are per operator, and both
# are counted in RECORDS, not requests: one reveal returning fifty chat bodies
# charges fifty units against the hourly budget and one against the daily one.
# The windows are fixed and clock-aligned (the hour resets on the hour, the day
# is a UTC day), not sliding, so a budget can be spent twice across a boundary.
# ---------------------------------------------------------------------------
HBD_ADMIN_REVEAL_RECORDS_PER_HOUR=200     # 10-2000: records unmasked per clock hour
HBD_ADMIN_REVEAL_CONVERSATIONS_PER_DAY=20 # 1-200: transcript pages per UTC day

# ---------------------------------------------------------------------------
# The name-verification threshold, MIRRORED from the worker. This is the only
# value here that this process does not own: name_match_min_similarity is the
# WORKER's setting (HBD_NAME_MATCH_MIN_SIMILARITY, default 0.85), and the panel
# reads no .env of the worker's, so it cannot discover the running value. Set
# this to whatever the worker is running and /generations/names marks it on the
# similarity histogram and counts the attempts within 0.05 of it — the number
# that says whether moving the threshold is safe. Leave it EMPTY and the panel
# says so: no marker, no cliff count, rather than a line nobody configured.
# Keep the two in step; a stale mirror draws the marker in the wrong place.
# ---------------------------------------------------------------------------
HBD_ADMIN_NAME_MATCH_MIN_SIMILARITY=      # 0.0-1.0, or empty for "not published"

# ---------------------------------------------------------------------------
# The data volume, MOUNTED READ-ONLY. The same directory the bot and the worker
# are given as their data root; the panel reads exactly one subdirectory of it,
# <root>/archive, and only through the Storage seam — never as a path built from
# anything a request supplied (§12.1 T4). Nothing here is created by the panel:
# it has no write permission on this tree, and a directory it conjured itself
# would be one the worker never writes into.
# ---------------------------------------------------------------------------
HBD_ADMIN_DATA_ROOT=var

# ---------------------------------------------------------------------------
# Probe token. Lets a fleet monitor read /readyz's detailed body without an
# operator session. Empty disables that path entirely — there is deliberately no
# default token to forget to change.
# ---------------------------------------------------------------------------
HBD_ADMIN_PROBE_TOKEN=
