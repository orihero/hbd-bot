# Bayram admin panel — copy to .env.admin and fill in. Never commit .env.admin.
# Read ONLY by the admin API process (`make admin`), which loads bayram.admin.settings.
# AdminSettings — not bayram.config.Settings. The bot and the worker never read this file.
#
# WHICH FILE IS THIS? `.env.admin` unless BAYRAM_ADMIN_ENV_FILE names another — `make admin
# ENV=prod` reads `.env.admin.prod`, and bayram-admin.service reads `/etc/bayram/admin.env`. It is
# a SECOND variable rather than a tier name shared with BAYRAM_ENV_FILE precisely because the
# panel reading a different file from the bot IS the vendor-key separation; one knob
# deriving both paths would be one edit away from collapsing it. Set it in the process
# environment — writing it in here has no effect. The boot-time credential scan follows the
# same selection, so a key in whichever file was loaded is the key that gets refused.
#
# WHY THIS FILE EXISTS AT ALL, AND WHY IT IS NOT .env
#
# There is deliberately NO vendor key and NO bot token here: not commented out, not
# empty, not optional — there is no field on AdminSettings that could hold one, so
# BAYRAM_TELEGRAM_BOT_TOKEN, BAYRAM_ELEVENLABS_API_KEY, BAYRAM_LLM_API_KEY,
# BAYRAM_LLM_FALLBACK_API_KEY and BAYRAM_OPENROUTER_MANAGEMENT_KEY have no code path into
# this process. The last of those is the newest and the sharpest — a management key can
# create and revoke OpenRouter API keys — and the panel RENDERS the balance it buys while
# being refused the credential that fetched it. That is the split working. That is the whole
# blast-radius argument for running the panel as a third process: an admin host that is
# compromised yields a database session and nothing else — no ability to message every
# customer as the bot, in perpetuity, and no ability to spend the vendor balance.
# Pointing the admin process at the shared .env would hand it all five by accident, which
# is why it reads its own file. In prod, any one of the five sitting in this process's
# environment is a boot REFUSAL naming the variable; in dev and staging it is a WARNING,
# because a shared dev .env is normal.
#
# The same rule downstream: the admin API sends nothing to Telegram and calls no vendor.
# Every action that needs one — a retry, a re-delivery, a file deletion — is enqueued as
# an ARQ job and performed by the worker, which is the process that holds the credentials
# and owns the writable volume.

# ---------------------------------------------------------------------------
# Runtime — the same three variables the bot reads, with the same meanings.
# ---------------------------------------------------------------------------
BAYRAM_ENVIRONMENT=dev                       # dev | staging | prod
BAYRAM_LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR
BAYRAM_IS_DEBUG=false                        # human-readable logs instead of JSON; never in prod

# DEBUG is a privacy decision, not a verbosity one: it is the level at which the ORM
# would echo bound SQL parameters — recipient names, notes, lyrics — into logs that have
# no retention clock. configure_logging() floors sqlalchemy, aiogram, arq and uvicorn at
# WARNING so it cannot, and the panel refuses to set DEBUG when BAYRAM_ENVIRONMENT=prod.

# ---------------------------------------------------------------------------
# Infrastructure — the SAME database and Redis the bot and worker use.
# The var/ volume is mounted READ-ONLY for this process (see below).
# ---------------------------------------------------------------------------
BAYRAM_DATABASE_URL=postgresql+asyncpg://hbd:hbd@localhost:5432/hbd
BAYRAM_REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# The panel itself. Off by default: an admin surface that appears because a
# dependency was installed is not a decision anybody made.
# ---------------------------------------------------------------------------
BAYRAM_ADMIN_ENABLED=false

# The config editor's own switch, so the riskiest surface in the panel can be taken away
# without taking the panel away. Read only from this file — never from the override table,
# or a stolen session could turn the kill switch back on.
BAYRAM_ADMIN_CONFIG_ENABLED=true

# Bind to loopback and put TLS in front of it. Binding 0.0.0.0 publishes a
# username/password login to the internet; nothing here is designed for that.
BAYRAM_ADMIN_HOST=127.0.0.1
BAYRAM_ADMIN_PORT=8080

# The origin the browser actually reaches, scheme included. Used for the CSP, for
# same-origin checks and for cookie scope, so a wrong value fails visibly rather than
# leaving a control half-applied. REQUIRED whenever BAYRAM_ENVIRONMENT is not dev: the
# loopback value below is a dev convenience, and a staging or prod deploy that inherited
# it would boot, pass /healthz, serve a login page and then reject every state change
# with ORIGIN_REJECTED. Leaving it unset outside dev is a boot refusal instead.
#
# In dev — and ONLY in dev — the value may be `*`, which accepts every Origin and also a
# request that carries none. That is the whole pre-session CSRF control switched off: it is
# there so the SPA can run on whatever port Vite picked (5173, 5174, a colleague's) without
# restarting the API. `*` with BAYRAM_ENVIRONMENT=staging or prod is a boot refusal, because
# at that point any page on the internet could POST to the panel with the operator's cookie.
BAYRAM_ADMIN_PUBLIC_ORIGIN=http://127.0.0.1:8080

# ---------------------------------------------------------------------------
# Sessions. Two clocks, both enforced: an absolute cap the operator cannot slide
# past, and an idle window that expires an unattended browser sooner.
# ---------------------------------------------------------------------------
BAYRAM_ADMIN_SESSION_TTL_S=43200             # 12h absolute lifetime, refresh or not
BAYRAM_ADMIN_SESSION_IDLE_TTL_S=3600         # 1h since last request

# How long one step-up authorises further actions in the SAME scope, in seconds (0-900).
# 0 makes every action in a scope re-prompt. Purge and config commit/rollback ignore this
# entirely — they are unconditionally fresh — so raising it cannot loosen them.
BAYRAM_ADMIN_STEP_UP_GRACE_SECONDS=300

# Session cookies are __Host-prefixed and SameSite=Lax, and Secure is sent in EVERY
# environment, dev included: the __Host- prefix is defined to make a browser reject a
# Set-Cookie that lacks Secure, so a dev panel without it stores no cookie and can never
# be signed into. http://127.0.0.1 is a secure context in Chrome and Firefox, so this
# costs dev nothing. Leave empty; setting it to false is refused at boot.
BAYRAM_ADMIN_COOKIE_SECURE=

# ---------------------------------------------------------------------------
# argon2id. These are the cost of one login, paid on the admin host. Raise them
# until a verify takes ~250-500ms on YOUR hardware; the defaults assume a small
# VPS. Lowering them below the floors is refused, not warned about.
# ---------------------------------------------------------------------------
BAYRAM_ADMIN_ARGON2_TIME_COST=3              # passes
BAYRAM_ADMIN_ARGON2_MEMORY_KIB=65536         # 64 MiB per verify — the parameter that matters
BAYRAM_ADMIN_ARGON2_PARALLELISM=4            # lanes; keep at or below the host's cores

# ---------------------------------------------------------------------------
# Client IP derivation. Every rate limit and every audit row records the client
# IP, so getting this wrong is not cosmetic: trusting X-Forwarded-For from an
# untrusted peer lets anyone forge the identity the throttle counts against.
#
# 0 hops means "use the peer address and ignore X-Forwarded-For entirely" — the
# right answer when nothing is in front of the process. Set it to the exact
# number of proxies you control, and list their addresses in the CIDR line; an
# XFF header from a peer outside that list is discarded, never merged.
# ---------------------------------------------------------------------------
BAYRAM_ADMIN_TRUSTED_PROXY_HOPS=0
BAYRAM_ADMIN_TRUSTED_PROXY_CIDRS=            # comma-separated, e.g. 10.0.0.0/8,192.168.1.5/32

# ---------------------------------------------------------------------------
# Audit log. The chain is HMAC-signed so a row cannot be edited in place without
# the break being detectable. This key is the only secret in this file: it is not
# a vendor credential, it protects the record of what operators did.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
BAYRAM_ADMIN_AUDIT_HMAC_KEY=

# The audit table's OWNER role, which is NOT the role the app connects as. Its presence is
# what says the two-role setup of §4.5 is deployed: with it, migration 0007 revokes
# UPDATE/DELETE/TRUNCATE on admin_audit_log from the application role, so a compromised
# app credential cannot rewrite the record of what operators did. Leave it EMPTY and that
# REVOKE is skipped with a WARNING, and /audit/verify reports chainProtection "hmac-only"
# — a control that is not deployed is reported as not deployed, never implied.
BAYRAM_ADMIN_AUDIT_DSN=

# ---------------------------------------------------------------------------
# Reveal budgets. A step-up authorises ONE action; these cap how much personal
# data one operator can pull in a shift, which is the difference between an
# investigation and an export nobody asked for. Both are per operator, and both
# are counted in RECORDS, not requests: one reveal returning fifty chat bodies
# charges fifty units against the hourly budget and one against the daily one.
# The windows are fixed and clock-aligned (the hour resets on the hour, the day
# is a UTC day), not sliding, so a budget can be spent twice across a boundary.
# ---------------------------------------------------------------------------
BAYRAM_ADMIN_REVEAL_RECORDS_PER_HOUR=200     # 10-2000: records unmasked per clock hour
BAYRAM_ADMIN_REVEAL_CONVERSATIONS_PER_DAY=20 # 1-200: transcript pages per UTC day

# ---------------------------------------------------------------------------
# The name-verification threshold, MIRRORED from the worker. This is the only
# value here that this process does not own: name_match_min_similarity is the
# WORKER's setting (BAYRAM_NAME_MATCH_MIN_SIMILARITY, default 0.85), and the panel
# reads no .env of the worker's, so it cannot discover the running value. Set
# this to whatever the worker is running and /generations/names marks it on the
# similarity histogram and counts the attempts within 0.05 of it — the number
# that says whether moving the threshold is safe. Leave it EMPTY and the panel
# says so: no marker, no cliff count, rather than a line nobody configured.
# Keep the two in step; a stale mirror draws the marker in the wrong place.
# ---------------------------------------------------------------------------
BAYRAM_ADMIN_NAME_MATCH_MIN_SIMILARITY=      # 0.0-1.0, or empty for "not published"

# ---------------------------------------------------------------------------
# The settlement grace, MIRRORED from the worker. The second of the three values
# this process republishes rather than owns. The bot's gate counts a customer's
# unsettled debits newer than (now - settlement_grace_s) and refuses at the
# in-flight cap; the panel shows that count as inFlightRenderCount, which is the
# only number on the user screen that explains such a refusal. The worker's
# grace is BAYRAM_SETTLEMENT_GRACE_S, or DERIVED from its queue ladder when that is
# unset (job timeout, max tries, backoff base), so it moves when the queue is
# retuned. Set this to whatever the worker resolved and the two agree; leave it
# EMPTY and the panel counts against the shipped default (4550s) — which is
# correct on an untouched deployment and wrong the moment the worker's is not.
# The value in force is published on GET /api/config either way, so an operator
# can see which clock produced the number.
# ---------------------------------------------------------------------------
BAYRAM_ADMIN_SETTLEMENT_GRACE_S=             # 1-86400 seconds, or empty for the default

# ---------------------------------------------------------------------------
# The free allowance, MIRRORED from the worker. The third and last value this
# process republishes rather than owns, and the one added after it went wrong.
# The user screen publishes creditsProjected: what the bot would tell this
# customer they have right now, stored balance plus a rolling free allowance
# that is due and not yet minted. That allowance is the worker's
# BAYRAM_FREE_ALLOWANCE_CREDITS, and the panel reads no .env of the worker's, so it
# cannot discover the running value. It used to assume the allowance was a
# constant and add the old default of 3 to everybody: since the paywall shipped
# the worker's value is 0, a zero allowance is never "minted", so "an allowance
# is due" stays true forever and the 3 was added to every customer on every
# read. A customer who had just paid 7 000 UZS for one song read 1 on their own
# Confirm screen while the operator on the phone to them read 4.
# Leave this at 0 — what the bot ships — and the two agree. Raise it only in
# lockstep with the worker's BAYRAM_FREE_ALLOWANCE_CREDITS, because the number this
# publishes is the one an operator quotes back to a customer disputing a
# balance. Empty is read as 0, not as a boot failure.
# ---------------------------------------------------------------------------
BAYRAM_ADMIN_FREE_ALLOWANCE_CREDITS=0        # 0-100 free songs per window, as the worker runs it

# ---------------------------------------------------------------------------
# The FX rate. Revenue is recorded in UZS tiyin and vendor cost in USD, and
# nothing in this system holds a rate between them — so the dashboard's Net card
# and its revenue-versus-cost chart cannot be drawn until an operator sets one
# here. This value is OWNED by the panel and mirrored from nothing: every vendor
# rate card in the product is already quoted in USD, so the bot and the worker
# have no use for it and it is absent from .env.
#
# LEAVE BOTH BLANK and the panel shows an em-dash where the converted figure
# would be, and converts nothing anywhere. That is deliberate: a default of 1.0
# would imply parity and make 7 000 soʻm read as $7 000 against $3.47 of cost —
# a 200 000% margin on the one card that exists to say whether the business
# works — and a "plausible" 12 800 would be a number nobody chose, drifting with
# the som and presented with the confidence of one an operator entered.
#
# BLANK IS NOT AN OUTAGE AND MUST NOT BE READ AS ONE. With both of these empty
# the MRR and ARR cards render an em dash carrying the reason `no_fx_rate`, and
# the dashboard's Net card draws its revenue in UZS and its cost in USD side by
# side without combining them. The panel is working; it is declining to invent
# the one number nobody gave it. An operator who wants those cards filled in
# supplies a rate, and owns it thereafter.
#
# THE DATE IS MANDATORY WHENEVER THE RATE IS SET, and a boot refusal names both
# variables if only one is filled in. There is no feed behind this number; the
# as-of date is the only staleness signal the panel has, and it only works if
# the panel renders it beside the rate. The server never converts: every payload
# carries the amount in its own currency, the cost in USD, and this rate beside
# them, so a chart is reproducible from its own response and editing the rate
# never silently revalues a figure that was already reported.
#
# BOTH OR NEITHER, AND HALF A PAIR IS A CRASH LOOP, NOT A WARNING. The
# `_the_fx_rate_carries_its_date` model validator (src/bayram/admin/settings.py)
# refuses the boot outright when exactly one of the two is set, so under systemd
# the admin unit restarts, refuses, restarts — with the panel simply unreachable
# rather than showing a degraded card. Filling in three of these four variables
# and leaving the fourth for later is therefore an outage, and it is the single
# most likely way to cause one from this file. Set a pair, or set neither.
#
# Each variable's explanation is ABOVE it below, and that is not a style
# preference. python-dotenv strips an inline `#` comment only when the value
# before it is non-empty; on a blank assignment the comment BECOMES the value,
# so `BAYRAM_ADMIN_UZS_PER_USD=  # e.g. 12800` is not a blank rate — it is the
# literal string "# e.g. 12800", which fails to parse as a number and takes the
# boot down. These four lines shipped in exactly that shape until 2026-09-15.
# ---------------------------------------------------------------------------

# Soʻm per USD, e.g. 12800. A hand-mirrored rate, not a feed. Blank = no rate
# published, and MRR/ARR render an em dash reading `no_fx_rate`.
BAYRAM_ADMIN_UZS_PER_USD=

# YYYY-MM-DD the rate above was taken. MANDATORY whenever the rate is set, and
# blank whenever it is not — there is no third state.
BAYRAM_ADMIN_UZS_PER_USD_AS_OF=

# ---------------------------------------------------------------------------
# The shipped price, MIRRORED from the worker. BAYRAM_SINGLE_SONG_PRICE_MINOR is
# the WORKER's setting and this process reads no .env of the worker's, so it
# cannot discover the running value; publishing the bot model's default would
# put a price on every Finance card that a deployment may not be charging.
#
# It prices a HYPOTHETICAL — "songs delivered × the shipped price" — and never a
# historical sale. Recorded revenue comes from the receipt tables, and nothing
# may back-price a past sale at a value read today. Leave both blank and the
# derived figure is null and the chart draws no price line.
#
# BLANK IS NOT AN OUTAGE HERE EITHER. With both empty, the Finances tab's
# "Est. revenue" card renders an em dash carrying the reason `no_price_published`
# — not a zero, and not a figure derived from the bot model's default. Recorded
# sales are unaffected and keep totalling in their own currency, because they
# come from the receipt tables and never from this number.
#
# The currency travels with the price and the two are set together or not at
# all, for the same reason a cost carries its source: an amount with no currency
# cannot be summed or compared, and one half without the other is a boot refusal
# naming both variables.
#
# BOTH OR NEITHER, AND HALF A PAIR IS A CRASH LOOP, NOT A WARNING — the same
# rule as the FX pair above, enforced by `_the_mirrored_price_carries_its_currency`
# (src/bayram/admin/settings.py). A price with no currency does not degrade to a
# card with no unit; it refuses the boot, and systemd then restarts the refusal
# every few seconds. Set a pair, or set neither.
#
# The explanation sits ABOVE each variable for the python-dotenv reason spelled
# out over the FX pair: on a blank assignment a trailing `#` comment is not a
# comment, it is the value.
# ---------------------------------------------------------------------------

# Minor units (UZS tiyin), e.g. 1500000 for the 15 000 soʻm this deployment
# charges today. MIRRORED BY HAND from the worker's BAYRAM_SINGLE_SONG_PRICE_MINOR,
# which this process cannot read. Blank = unpublished, and "Est. revenue" renders
# an em dash reading `no_price_published`.
BAYRAM_ADMIN_SINGLE_SONG_PRICE_MINOR=

# ISO-4217, exactly 3 letters, e.g. UZS. The currency of the price above, and
# blank whenever that is blank.
BAYRAM_ADMIN_KIT_CURRENCY=

# ---------------------------------------------------------------------------
# Dashboard query bounds. These shape what the aggregate endpoints will answer,
# and every one of them fails loudly rather than quietly: a window too wide for
# its bucket is a 422 naming the parameter, never a silently coarsened chart.
# ---------------------------------------------------------------------------
BAYRAM_ADMIN_DASHBOARD_RUN_RATE_DAYS=30      # 1-365: the run-rate card's OWN window, not the selector's
BAYRAM_ADMIN_DASHBOARD_MAX_HOURLY_WINDOW_DAYS=8  # 1-31: 8, so a week plus its prior week still fits
BAYRAM_ADMIN_DASHBOARD_MAX_SERIES_BUCKETS=750    # 24-5000: clears a year of days and a month of hours

# ---------------------------------------------------------------------------
# Broadcasts.
#
# BAYRAM_ADMIN_BROADCAST_TEST_RECIPIENTS is the ONLY set of Telegram accounts the
# test-send route may reach. Empty — the shipped value — turns that route off.
# Without it the endpoint is "send arbitrary operator-authored text to any
# customer id you can type": the step-up in front of it proves who is asking and
# the audit row behind it records that they did, but neither bounds WHO receives
# it. Put the operators' own Telegram ids here, comma-separated, and nobody
# else's.
#
# BAYRAM_ADMIN_BROADCAST_AUDIENCE_DRIFT_TOLERANCE is how far the real audience may
# have moved from the count the compose wizard rendered before creating the
# campaign is refused with 409. A fraction of the expected size. It is not 0
# because people sign up between the preview and the button press, and a rule
# that refuses correct requests is a rule operators route around.
# ---------------------------------------------------------------------------
BAYRAM_ADMIN_BROADCAST_TEST_RECIPIENTS=
BAYRAM_ADMIN_BROADCAST_AUDIENCE_DRIFT_TOLERANCE=0.05

# ---------------------------------------------------------------------------
# The data volume, MOUNTED READ-ONLY. The same directory the bot and the worker
# are given as their data root; the panel reads exactly one subdirectory of it,
# <root>/archive, and only through the Storage seam — never as a path built from
# anything a request supplied (§12.1 T4). Nothing here is created by the panel:
# it has no write permission on this tree, and a directory it conjured itself
# would be one the worker never writes into.
# ---------------------------------------------------------------------------
BAYRAM_ADMIN_DATA_ROOT=var

# ---------------------------------------------------------------------------
# Probe token. Lets a fleet monitor read /readyz's detailed body without an
# operator session. Empty disables that path entirely — there is deliberately no
# default token to forget to change.
# ---------------------------------------------------------------------------
BAYRAM_ADMIN_PROBE_TOKEN=
