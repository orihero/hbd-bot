# Secrets — never commit
.env
.env.*
!.env.example
!.env.admin.example
# The Payme gateway's example dotenv. It must be negated explicitly like the other two:
# `.env.*` on line 3 swallows it silently, so without this line the file is a deliverable
# that never appears in `git status` and is therefore never committed.
!.env.payme.example
# The admin process's own environment. Separate from .env so a shared file cannot leak a
# vendor key into a process that must not hold one.
.env.admin
# The gateway's own environment. Separate again, because it holds the ONE inbound
# verification secret — the merchant key, whose theft mints credits — and no process that
# holds a vendor key may be able to read it.
.env.payme
*.pem
*.key

# Node — the ROOT node_modules too, not only the SPA's. A vitest cache file under it
# reached `git add -A` back when only one package's `node_modules/` was listed below.
node_modules/

# Multi-agent tooling scratch: per-run auditor/challenger transcripts, 1.4 MB and growing,
# regenerated on every run and meaningful to nobody tomorrow.
.agents/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local artefacts
/tmp/
/media/
# Workspace + local object storage written by bayram.runtime (see AppContainer.data_root)
/var/
/assets_local/
*.mp3
*.ogg
*.wav
*.opus
!tests/**/fixtures/**

# Admin panel — the SPA's build output is a build artefact, not source. The API serves
# src/bayram/admin/static/, which `npm run build` writes; committing it would let the served
# bundle drift from admin-dashboard/ with nothing to notice.
src/bayram/admin/static/
admin-dashboard/coverage/

# Editors / OS
.idea/
.vscode/
.DS_Store

# Personal Claude Code overrides — grants production host access, never committed
.claude/settings.local.json

# Campaign working trees under marketing/campaigns/. The audio rules above catch *.mp3/*.wav
# and NO video or image extension at all, so `git add -A` would stage ~1.3 GB of h264 and PNG
# frames from the peshta build alone.
#
# Scoped to `campaigns/` on purpose, twice over. It is NOT a blanket `marketing/` line, because
# marketing/brand/Logo-Bot.png is tracked and is the source of truth the packaged cover art is
# copied from (tests/test_audio/test_cover.py fails if the two drift). And it is NOT a blanket
# `marketing/campaigns/peshta/` line, because docs/README.md cites that campaign's
# 06_local/compare_ab.py and render_budget.json as live artefacts.
#
# A new campaign folder inherits these rules with no edit here, which is the point of the glob.
marketing/campaigns/**/*.mp4
marketing/campaigns/**/*.mov
marketing/campaigns/**/*.mkv
marketing/campaigns/**/*.png
marketing/campaigns/**/*.jpg
marketing/campaigns/**/*.jpeg
marketing/campaigns/**/*.webp
marketing/campaigns/**/*.m4a
marketing/campaigns/**/*.aac
# Raw PCM dumps written by the loudness QA pass (05_build/qa/). Binary, 6 MB, and
# regenerated by re-running the check — the measured numbers live in the .md beside them.
marketing/campaigns/**/*.raw

# A convenience symlink to a rightsholder's 1080p master, with an absolute target that is
# broken on any other machine. Not ours to carry into history.
/Xamdam_Sobirov_Peshta.mp4

# Written at the repository root by an external agent harness on every run (it writes the
# .agents/ copy in the same breath). Untracked so the root rule holds without fighting a tool
# that will win; kept on disk because the harness expects it there.
/ORIGINAL_REQUEST.md

# Built wheels, wherever a build drops them. `dist/` above catches the standard location;
# this catches the ad-hoc ones. Staging a wheel is how a stale pre-rename build gets shipped.
/dist_*/
