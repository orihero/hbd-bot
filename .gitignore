# Secrets — never commit
.env
.env.*
!.env.example
!.env.admin.example
# The admin process's own environment. Separate from .env so a shared file cannot leak a
# vendor key into a process that must not hold one.
.env.admin
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local artefacts
/tmp/
/media/
# Workspace + local object storage written by hbd.runtime (see AppContainer.data_root)
/var/
/assets_local/
*.mp3
*.ogg
*.wav
*.opus
!tests/**/fixtures/**

# Admin panel — the SPA's build output is a build artefact, not source. The API serves
# src/hbd/admin/static/, which `npm run build` writes; committing it would let the served
# bundle drift from admin-ui/ with nothing to notice.
admin-ui/node_modules/
admin-ui/dist/
src/hbd/admin/static/

# Editors / OS
.idea/
.vscode/
.DS_Store
