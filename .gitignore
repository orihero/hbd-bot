# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local artefacts
/tmp/
/media/
# Workspace + local object storage written by hbd.runtime (see AppContainer.data_root)
/var/
/assets_local/
*.mp3
*.ogg
*.wav
*.opus
!tests/**/fixtures/**

# Editors / OS
.idea/
.vscode/
.DS_Store
